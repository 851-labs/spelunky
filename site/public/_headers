# Headers for the files served without the Worker (it sets its own: see src/server.ts), and for the wiki's clips,
# which it serves with byte ranges and these headers. All are named by a hash of their contents, so they never
# change: play/v/HASH/ by scripts/web --package, assets/ by Vite, wiki/media/HASH/ by site/wiki-media.sh
# (HASH being the media package's), and wiki/og/NAME.HASH.png by src/wiki/build/og.ts (HASH its bytes').
/play/v/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/wiki/media/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
# The media package's LICENSE.txt and NOTICE.txt (scripts/wiki-media-package), in UTF-8. The asset store serves
# .txt as text/plain without a charset, which a browser decodes by guessing, often as windows-1252, and they skip
# the Worker, which adds it to the other .txt files (src/server.ts). A Content-Type here replaces the store's.
/wiki/media/*.txt
  Content-Type: text/plain; charset=utf-8
/wiki/og/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
