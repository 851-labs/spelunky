# Headers for the files served without the Worker (it sets its own: see src/server.ts). Both are named by a
# hash of their contents, so they never change: play/v/HASH/ by scripts/web --package, assets/ by Vite.
/play/v/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
