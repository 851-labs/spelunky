// spelunky.ai: a TanStack Start app (src/) as a Worker with static assets: the pre-rendered pages, the
// landing page's media (public/), the web build at /play/ and the wiki's media at /wiki/media/. Cloudflare's
// Workers Builds runs build.sh, which builds it with Vite into dist/, then `npx wrangler deploy`, which
// deploys dist/server/wrangler.json (the Cloudflare Vite plugin's output, named by
// .wrangler/deploy/config.json); see docs/web-deploy.md. No API token anywhere: Workers Builds deploys with
// its own credentials.
{
  "name": "spelunky",
  // Account "851". Not a secret, and pinning it keeps a deploy from landing in another account.
  "account_id": "630f294bcb2c1e9b751d9fe0655a453a",
  "main": "./src/server.ts",
  "compatibility_date": "2025-10-01",
  // TanStack Start's server runtime uses node:async_hooks.
  "compatibility_flags": ["nodejs_compat"],
  // The directory is Vite's client output, dist/client, which the plugin fills in.
  "assets": {
    "binding": "ASSETS",
    // /play redirects to /play/, which serves play/index.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker sees everything but the content-hashed files: it redirects www and marks what it serves
    // no-cache. /play/v/* (the game), /assets/* (the pages' scripts) and /wiki/media/* (the wiki's sprites
    // and clips, under the package's hash) are served straight from the asset store (no Worker invocation,
    // so no request quota spent on the ~100 files a game start fetches, or a wiki page's dozens of
    // images), with _headers' immutable caching. All but the clips' videos, that is, which the Worker
    // serves with byte ranges for Safari (src/server.ts). A negative rule beats a positive one, and `*`
    // spans directories, so the rules pick the package's other files by extension: every file in it is a
    // .png, .json, .txt, .mp4 or .webm.
    // (So www.spelunky.ai/play/v/... isn't redirected, but only a page on www, which is, would ask for it.)
    "run_worker_first": [
      "/*",
      "!/play/v/*",
      "!/assets/*",
      "!/wiki/media/*.png",
      "!/wiki/media/*.json",
      "!/wiki/media/*.txt"
    ]
  },
  // Zone spelunky.ai (6661e9e5fb33bb71d0d23105fc615009) is in the same account; deploying creates the
  // DNS records and certificates.
  "routes": [
    { "pattern": "spelunky.ai", "custom_domain": true },
    { "pattern": "www.spelunky.ai", "custom_domain": true }
  ],
  "workers_dev": false,
  // Pull requests that change site/ upload a version (`wrangler versions upload`) whose link Workers Builds
  // posts on the PR. Every deploy applies this setting, so it has to be on here: false turned the previews
  // off again on each deploy from main. Previews live on workers.dev; spelunky.ai is unaffected.
  "preview_urls": true
}
