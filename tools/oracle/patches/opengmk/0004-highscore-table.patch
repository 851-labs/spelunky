new file mode 100644
--- /dev/null
+++ b/gm8emulator/src/game/highscore.rs
@@ -0,0 +1,24 @@
+//! In-memory GM8 highscore table (oracle patch).
+//!
+//! GM8 keeps a 10-entry table sorted by descending score, and Spelunky uses it as save data
+//! (`scrUpdateHighscores`, `scrResetHighscores`). Upstream OpenGMK doesn't implement it. This table lives only in
+//! memory and in savestates; it is never read from or written to disk, so every run starts from a known table.
+
+use crate::{gml, math::Real};
+
+pub const SIZE: usize = 10;
+
+pub type Table = Vec<(gml::String, Real)>;
+
+/// The table of a game that has never written a highscore (and what `highscore_clear` leaves).
+pub fn fresh() -> Table {
+    (0..SIZE).map(|_| (gml::String::from("<nobody>"), Real::from(0.0))).collect()
+}
+
+/// `highscore_add`: insert above the first entry with a strictly lower score and drop the 11th.
+pub fn add(table: &mut Table, name: gml::String, score: Real) {
+    if let Some(pos) = table.iter().position(|(_, s)| score > *s) {
+        table.insert(pos, (name, score));
+        table.truncate(SIZE);
+    }
+}
