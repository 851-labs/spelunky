+
+// ---------------------------------------------------------------------------
+// Spelunky oracle: a text replay's joystick (851-3949), as GM8's runner reads it through winmm on every
+// joystick_* call (Spelunky.exe 0x565240-0x565cf6): joyGetPosEx's raw axes (0-65535) and POV (hundredths of a
+// degree, 65535 centred), its 32 buttons, and joyGetDevCaps' POV flag. A text replay gives each axis as GM8
+// reports it (raw / 32767 - 1) and the POV in degrees, so they're taken back to the raw values here, as the
+// port's gm::input does, and every function answers from those.
+// ---------------------------------------------------------------------------
+
+#[derive(Clone, Copy, Debug, Default, Serialize, Deserialize)]
+pub struct Joystick {
+    pub has_pov: bool,
+    pub buttons: u32,
+    /// Raw x, y and z.
+    pub axes: [u32; 3],
+    pub pov: u32,
+}
+
+impl Joystick {
+    pub fn new(has_pov: bool) -> Self {
+        Self { has_pov, buttons: 0, axes: [32767; 3], pov: 65535 }
+    }
+
+    pub fn set_axis(&mut self, axis: u8, v: f64) {
+        match axis {
+            0..=2 => {
+                let v = if v.is_nan() { 0.0 } else { v };
+                self.axes[axis as usize] = crate::math::ieee_round((v + 1.0) * 32767.0).clamp(0.0, 65535.0) as u32;
+            },
+            _ => {
+                self.pov = if v.is_nan() || v < 0.0 {
+                    65535
+                } else {
+                    crate::math::ieee_round(v * 100.0).min(65535.0) as u32
+                };
+            },
+        }
+    }
 }
 
