+// ---------------------------------------------------------------------------
+// Text replays (oracle tooling). The format is the spelunky port's (docs/formats.md in the port's repo):
+//
+//   # comment
+//   seed 12345                 (RNG seed at the start of frame 0, i32; default 0)
+//   time 1262304000000000000   (spoofed start clock in ns; default 2010-01-01)
+//   frames 600                 (replay length; default = last event frame + 1)
+//   room rScreenInit           (only the default first room is supported)
+//   settings 0 1 0 1 3 15 15   (settings.cfg; also `keys` + 12 ints, `gamepad` + 8 or 9 ints)
+//   highscore 9000000 "MONEY"  (one highscore table entry, repeated in table order, best first)
+//   file stats.txt "..."       (another file in the game directory; contents as a JSON string)
+//   30 press enter             (key or mb_left/mb_right/mb_middle down at the start of frame 30)
+//   45 release enter
+//   60 hold right 20           (press on 60, release on 80)
+//   70 wheel up                (or `wheel down`)
+//   80 mouse 100 50            (the mouse moves to (100, 50) in window pixels)
+//
+// Joystick directives and events are rejected: OpenGMK's joystick functions are stubs (no joystick).
+// ---------------------------------------------------------------------------
+
+/// Named keys besides letters and digits: GM8's `vk_*` constants without the prefix, plus aliases.
+const KEY_NAMES: &[(&str, u8)] = &[
+    ("backspace", 8), ("tab", 9), ("enter", 13), ("return", 13), ("shift", 16), ("control", 17), ("ctrl", 17),
+    ("alt", 18), ("pause", 19), ("escape", 27), ("esc", 27), ("space", 32), ("pageup", 33), ("pagedown", 34),
+    ("end", 35), ("home", 36), ("left", 37), ("up", 38), ("right", 39), ("down", 40), ("printscreen", 44),
+    ("insert", 45), ("delete", 46), ("numpad0", 96), ("numpad1", 97), ("numpad2", 98), ("numpad3", 99),
+    ("numpad4", 100), ("numpad5", 101), ("numpad6", 102), ("numpad7", 103), ("numpad8", 104), ("numpad9", 105),
+    ("multiply", 106), ("add", 107), ("subtract", 109), ("decimal", 110), ("divide", 111), ("f1", 112),
+    ("f2", 113), ("f3", 114), ("f4", 115), ("f5", 116), ("f6", 117), ("f7", 118), ("f8", 119), ("f9", 120),
+    ("f10", 121), ("f11", 122), ("f12", 123),
+];
+
+/// A key: a letter or digit, a name, or a code as `NN` (two or more digits; one digit is that digit's key)
+/// or `vkNN`. Codes 0 and 1 are GM's pseudo-keys `vk_nokey` and `vk_anykey`.
+fn parse_key(s: &str) -> Result<u8, String> {
+    let lower = s.to_ascii_lowercase();
+    let code = |d: &str| if !d.is_empty() && d.bytes().all(|b| b.is_ascii_digit()) { d.parse::<u8>().ok() } else { None };
+    let vk = match lower.as_bytes() {
+        [c] if c.is_ascii_alphanumeric() => Some(c.to_ascii_uppercase()),
+        _ => code(&lower)
+            .or_else(|| lower.strip_prefix("vk").and_then(code))
+            .or_else(|| KEY_NAMES.iter().find(|(name, _)| *name == lower).map(|(_, vk)| *vk)),
+    };
+    match vk {
+        Some(vk) if vk >= 2 => Ok(vk),
+        Some(vk) => Err(format!("key code {} is a pseudo-key", vk)),
+        None => Err(format!("bad key {:?}", s)),
+    }
+}
+
+/// A button as the press/release events of a frame: a key or a mouse button (GM's mb_* codes).
+fn parse_button(s: &str, down: bool) -> Result<Input, String> {
+    let mouse = match s.to_ascii_lowercase().as_str() {
+        "mb_left" => Some(1),
+        "mb_right" => Some(2),
+        "mb_middle" => Some(3),
+        b if b.starts_with("joy") => return Err(JOYSTICK_UNSUPPORTED.into()),
+        _ => None,
+    };
+    Ok(match (mouse, down) {
+        (Some(b), true) => Input::MousePress(b),
+        (Some(b), false) => Input::MouseRelease(b),
+        (None, true) => Input::KeyPress(parse_key(s)?),
+        (None, false) => Input::KeyRelease(parse_key(s)?),
+    })
+}
+
+const JOYSTICK_UNSUPPORTED: &str = "joystick input isn't supported: OpenGMK's joystick functions are stubs";
+
+/// Parses one JSON string literal that makes up all of `s` (surrounding whitespace aside).
+fn parse_json_string(s: &str) -> Result<String, String> {
+    let bad = |m: &str| format!("expected one JSON string: {}", m);
+    let s = s.trim();
+    let body = s.strip_prefix('"').ok_or_else(|| bad("no opening quote"))?;
+    let mut out = String::new();
+    let mut chars = body.char_indices();
+    let hex4 = |chars: &mut std::str::CharIndices| -> Result<u32, String> {
+        let digits: String = chars.by_ref().take(4).map(|(_, c)| c).collect();
+        if digits.len() != 4 { return Err(bad("short \\u escape")) }
+        u32::from_str_radix(&digits, 16).map_err(|_| bad("bad \\u escape"))
+    };
+    while let Some((i, c)) = chars.next() {
+        match c {
+            '"' => {
+                return if body[i + 1..].trim().is_empty() { Ok(out) } else { Err(bad("text after the string")) }
+            },
+            '\\' => match chars.next().map(|(_, c)| c) {
+                Some('"') => out.push('"'),
+                Some('\\') => out.push('\\'),
+                Some('/') => out.push('/'),
+                Some('b') => out.push('\u{8}'),
+                Some('f') => out.push('\u{c}'),
+                Some('n') => out.push('\n'),
+                Some('r') => out.push('\r'),
+                Some('t') => out.push('\t'),
+                Some('u') => {
+                    let mut code = hex4(&mut chars)?;
+                    if (0xd800..0xdc00).contains(&code) {
+                        // a high surrogate must be followed by an escaped low one
+                        if chars.next().map(|(_, c)| c) != Some('\\') || chars.next().map(|(_, c)| c) != Some('u') {
+                            return Err(bad("lone surrogate"))
+                        }
+                        let low = hex4(&mut chars)?;
+                        if !(0xdc00..0xe000).contains(&low) { return Err(bad("lone surrogate")) }
+                        code = 0x10000 + ((code - 0xd800) << 10) + (low - 0xdc00);
+                    }
+                    out.push(char::from_u32(code).ok_or_else(|| bad("lone surrogate"))?);
+                },
+                _ => return Err(bad("bad escape")),
+            },
+            c if (c as u32) < 0x20 => return Err(bad("raw control character")),
+            c => out.push(c),
+        }
+    }
+    Err(bad("no closing quote"))
+}
+
+/// The rest of `line` after its first `n` whitespace-separated tokens.
+fn after_tokens(line: &str, n: usize) -> &str {
+    let mut rest = line.trim_start();
+    for _ in 0..n {
+        let end = rest.find(char::is_whitespace).unwrap_or(rest.len());
+        rest = rest[end..].trim_start();
+    }
+    rest
+}
+
+/// A relative path that stays inside the game directory: `/`-separated, with no empty, `.` or `..`
+/// components, backslashes or drive letters.
+fn is_game_path(path: &str) -> bool {
+    !path.contains(['\\', ':']) && path.split('/').all(|c| !c.is_empty() && c != "." && c != "..")
+}
+
+/// A config file as config.exe writes it: the values joined by CRLF, with no trailing newline.
+fn cfg_file(values: &[&str], count: std::ops::RangeInclusive<usize>) -> Option<Vec<u8>> {
+    if !count.contains(&values.len()) || values.iter().any(|v| v.parse::<i32>().is_err()) {
+        return None
+    }
+    let values: Vec<String> = values.iter().map(|v| v.parse::<i32>().unwrap().to_string()).collect();
+    Some(values.join("\r\n").into_bytes())
+}
+
+/// What a text replay sets up besides the input.
+pub struct TextSetup {
+    /// The highscore table at startup, if the replay gives one.
+    pub highscores: Option<highscore::Table>,
+    /// Files to put in the game directory before launch: path relative to it, and contents.
+    pub files: Vec<(String, Vec<u8>)>,
+}
+
+impl Replay {
+    /// Parses a text replay. The highscore table and game files aren't part of `Replay` because .gmtas and .bin
+    /// files have no room for them (savestates carry the live table).
+    pub fn from_text(path: &PathBuf) -> Result<(Self, TextSetup), String> {
+        let text = std::fs::read_to_string(path).map_err(|e| e.to_string())?;
+        let mut setup = TextSetup { highscores: None, files: Vec::new() };
+        let mut seed = 0i32;
+        let mut time: u128 = 1_262_304_000_000_000_000;
+        let mut frames: Option<usize> = None;
+        // (frame, event, line number), in file order
+        let mut evs: Vec<(usize, Input, usize)> = Vec::new();
+        let mut moves: Vec<(usize, (i32, i32), usize)> = Vec::new();
+        for (ln, raw) in text.lines().enumerate() {
+            let ln = ln + 1;
+            let trimmed = raw.trim();
+            // these end in a JSON string, which may contain `#`
+            let line = if trimmed.starts_with("highscore ") || trimmed.starts_with("file ") {
+                trimmed
+            } else {
+                trimmed.split('#').next().unwrap().trim()
+            };
+            let t: Vec<&str> = line.split_whitespace().collect();
+            let err = |m: &str| format!("line {}: {}: {:?}", ln, m, line);
+            let frame = |f: &str| f.parse::<usize>().map_err(|_| err("bad frame"));
+            match t.as_slice() {
+                [] => (),
+                ["seed", v] => seed = v.parse().map_err(|_| err("bad seed"))?,
+                ["time", v] => time = v.parse().map_err(|_| err("bad time"))?,
+                ["frames", v] => frames = Some(v.parse().map_err(|_| err("bad frames"))?),
+                ["room", "rScreenInit"] => (),
+                ["room", _] => return Err(err("only `room rScreenInit` (the default) is supported")),
+                ["settings", vals @ ..] => {
+                    let cfg = cfg_file(vals, 7..=7).ok_or_else(|| err("settings takes 7 integers"))?;
+                    setup.files.push(("settings.cfg".into(), cfg));
+                },
+                ["keys", vals @ ..] => {
+                    let cfg = cfg_file(vals, 12..=12).ok_or_else(|| err("keys takes 12 integers"))?;
+                    setup.files.push(("keys.cfg".into(), cfg));
+                },
+                ["gamepad", vals @ ..] => {
+                    let cfg = cfg_file(vals, 8..=9).ok_or_else(|| err("gamepad takes 8 or 9 integers"))?;
+                    setup.files.push(("gamepad.cfg".into(), cfg));
+                },
+                ["joystick", ..] => return Err(err(JOYSTICK_UNSUPPORTED)),
+                ["highscore", v, ..] => {
+                    let v = v.parse::<f64>().ok().filter(|v| v.is_finite()).ok_or_else(|| err("bad highscore value"))?;
+                    let name = parse_json_string(after_tokens(line, 2)).map_err(|e| err(&e))?;
+                    let table = setup.highscores.get_or_insert_with(Vec::new);
+                    if table.len() == highscore::SIZE {
+                        return Err(err("the highscore table has only 10 entries"))
+                    }
+                    table.push((name.as_str().into(), v.into()));
+                },
+                ["file", path, ..] => {
+                    let contents = parse_json_string(after_tokens(line, 2)).map_err(|e| err(&e))?;
+                    if !is_game_path(path) {
+                        return Err(err("not a relative path inside the game directory"))
+                    }
+                    if ["settings.cfg", "keys.cfg", "gamepad.cfg"].iter().any(|c| c.eq_ignore_ascii_case(path)) {
+                        return Err(err("set the config files with their directives"))
+                    }
+                    setup.files.push((path.to_string(), contents.into_bytes()));
+                },
+                [f, "press", b] => evs.push((frame(f)?, parse_button(b, true).map_err(|e| err(&e))?, ln)),
+                [f, "release", b] => evs.push((frame(f)?, parse_button(b, false).map_err(|e| err(&e))?, ln)),
+                [f, "hold", b, n] => {
+                    let f = frame(f)?;
+                    let n: usize = n.parse().map_err(|_| err("bad hold length"))?;
+                    evs.push((f, parse_button(b, true).map_err(|e| err(&e))?, ln));
+                    evs.push((f + n, parse_button(b, false).map_err(|e| err(&e))?, ln));
+                },
+                [f, "wheel", "up"] => evs.push((frame(f)?, Input::MouseWheelUp, ln)),
+                [f, "wheel", "down"] => evs.push((frame(f)?, Input::MouseWheelDown, ln)),
+                [f, "mouse", x, y] => {
+                    let x = x.parse().map_err(|_| err("bad mouse x"))?;
+                    let y = y.parse().map_err(|_| err("bad mouse y"))?;
+                    moves.push((frame(f)?, (x, y), ln));
+                },
+                [_, "axis", ..] => return Err(err(JOYSTICK_UNSUPPORTED)),
+                _ => return Err(err("unrecognised")),
+            }
+        }
+        // a highscore table shorter than 10 is filled up with the fresh table's entries
+        if let Some(table) = setup.highscores.as_mut() {
+            let missing = highscore::SIZE - table.len();
+            table.extend(highscore::fresh().into_iter().take(missing));
+            // GM8 keeps the table sorted, and highscore_add relies on it
+            if table.windows(2).any(|w| w[0].1 < w[1].1) {
+                return Err("highscore entries must be best first, and scores below 0 need all 10 entries".into())
+            }
+        }
+
+        let last = evs.iter().map(|(f, _, _)| *f).chain(moves.iter().map(|(f, _, _)| *f)).max();
+        let len = frames.unwrap_or_else(|| last.map_or(0, |f| f + 1));
+        let mut lines = evs.iter().map(|(f, _, ln)| (*f, *ln)).chain(moves.iter().map(|(f, _, ln)| (*f, *ln)));
+        if let Some((f, ln)) = lines.find(|(f, _)| *f >= len) {
+            return Err(format!("line {}: event on frame {} beyond `frames {}`", ln, f, len))
+        }
+        let mut replay = Replay::new(time, seed);
+        for _ in 0..len {
+            replay.new_frame();
+        }
+        // a frame's events apply at its start, in file order
+        for (f, ev, _) in evs {
+            replay.get_frame_mut(f).unwrap().inputs.push(ev);
+        }
+        // the mouse stays where the last move put it
+        moves.sort_by_key(|(f, _, _)| *f);
+        let mut moves = moves.into_iter().peekable();
+        let mut pos = (0, 0);
+        for f in 0..len {
+            while let Some((_, p, _)) = moves.next_if(|(mf, _, _)| *mf == f) {
+                pos = p;
+            }
+            let frame = replay.get_frame_mut(f).unwrap();
+            (frame.mouse_x, frame.mouse_y) = pos;
+        }
+        Ok((replay, setup))
+    }
+}
