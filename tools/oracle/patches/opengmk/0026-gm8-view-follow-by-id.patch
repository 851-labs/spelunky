+    // Spelunky oracle: the active instance with this id, past a destroyed one with it, for view following. GM8's
+    // (`Spelunky.exe` 0x4beca4) scans the room's array of active instances for the first with the id that isn't
+    // marked destroyed, where `get_by_instid` stops at the first with the id. They differ while a persistent
+    // instance shares its id with one its room placed, which the load marks destroyed (the port's
+    // `InstanceList::follow_by_id`, probe `view-follow-id`, 851-3309).
+    pub fn get_followed_by_instid(&self, instance_index: ID) -> Option<usize> {
+        self.draw_order.iter().copied().find(|&inst| {
+            let inst = self.get(inst);
+            inst.id.get() == instance_index && inst.state.get() == InstanceState::Active
+        })
+    }
