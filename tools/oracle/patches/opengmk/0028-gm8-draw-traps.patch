+/// Spelunky oracle: the sine and cosine a draw takes of an angle in radians, `fsin` and `fcos` stored as doubles
+/// (the port's `math::draw_sin_cos`, 851-3304).
+pub fn gm8_draw_sin_cos(angle: f64) -> (f64, f64) {
+    (pxfm::x87::gm8::sin(angle), pxfm::x87::gm8::cos(angle))
+}
