diff --git a/gm8emulator/src/game/drawlog.rs b/gm8emulator/src/game/drawlog.rs
new file mode 100644
--- /dev/null
+++ b/gm8emulator/src/game/drawlog.rs
@@ -0,0 +1,166 @@
+//! Spelunky oracle: each frame's draw calls, for the dump's `draws` and `draw_calls` (the port's
+//! `gm::draw_calls` and its docs/formats.md, "Draw calls"; 851-3871).
+//!
+//! The draw built-ins, the default draw, the tiles, background layers and views of `Game::draw`, the surfaces and
+//! the back buffer's presents each log the call GML made, in the canonical form the port writes: what was asked
+//! for, not how the renderer carries it out (one call per `draw_text`, which OpenGMK draws glyph by glyph; a
+//! sprite's frame wrapped into its frame count; colours cut to 24 bits). The dump takes each frame's calls when it
+//! writes the frame's line ([`take`]), and the main loop drops whatever came before a frame ([`begin`]), so a
+//! line holds what was drawn from the frame's start to it.
+//!
+//! The hash is the port's `trace::canon::hash` of every call in order, each as its tag (8 bytes, little-endian)
+//! and its fields: an `i32` as 4 little-endian bytes, a real as its 8 (every NaN the same NaN), a `bool` as a byte,
+//! bytes as their length (8 bytes) and themselves. With `OPENGMK_DUMP_DRAWS=1` the calls are also listed, each as
+//! its name and fields separated by spaces: reals as Rust's shortest round trip, text as a JSON string of its
+//! bytes as Latin-1.
+
+use std::{cell::RefCell, fmt::Write as _};
+
+/// A call's field.
+#[derive(Clone, Copy)]
+pub enum Arg<'a> {
+    Int(i32),
+    Real(f64),
+    Bool(bool),
+    Bytes(&'a [u8]),
+}
+
+#[derive(Default)]
+struct Log {
+    /// The calls' canonical bytes.
+    bytes: Vec<u8>,
+    /// The calls, listed, if `OPENGMK_DUMP_DRAWS` is set.
+    list: Option<Vec<String>>,
+}
+
+thread_local! {
+    static LOG: RefCell<Log> = RefCell::new(Log::default());
+}
+
+/// Starts a frame's log, dropping what came before; with `list`, the calls are listed too.
+pub fn begin(list: bool) {
+    LOG.with(|log| {
+        let mut log = log.borrow_mut();
+        log.bytes.clear();
+        log.list = if list { Some(Vec::new()) } else { None };
+    })
+}
+
+/// Logs a call: its name, its tag and its fields.
+pub fn call(name: &str, tag: u64, args: &[Arg]) {
+    LOG.with(|log| {
+        let mut log = log.borrow_mut();
+        let log = &mut *log;
+        log.bytes.extend_from_slice(&tag.to_le_bytes());
+        for a in args {
+            match *a {
+                Arg::Int(n) => log.bytes.extend_from_slice(&n.to_le_bytes()),
+                Arg::Real(r) => {
+                    let r = if r.is_nan() { f64::NAN } else { r };
+                    log.bytes.extend_from_slice(&r.to_bits().to_le_bytes());
+                },
+                Arg::Bool(b) => log.bytes.push(u8::from(b)),
+                Arg::Bytes(b) => {
+                    log.bytes.extend_from_slice(&(b.len() as u64).to_le_bytes());
+                    log.bytes.extend_from_slice(b);
+                },
+            }
+        }
+        if let Some(list) = &mut log.list {
+            let mut line = name.to_string();
+            for a in args {
+                line.push(' ');
+                match *a {
+                    Arg::Int(n) => {
+                        let _ = write!(line, "{}", n);
+                    },
+                    Arg::Real(r) => {
+                        let _ = write!(line, "{:?}", r);
+                    },
+                    Arg::Bool(b) => {
+                        let _ = write!(line, "{}", b);
+                    },
+                    Arg::Bytes(b) => {
+                        line.push('"');
+                        for &c in b {
+                            match c {
+                                b'"' => line.push_str("\\\""),
+                                b'\\' => line.push_str("\\\\"),
+                                c if c < 0x20 => {
+                                    let _ = write!(line, "\\u{:04x}", c);
+                                },
+                                c => line.push(char::from(c)),
+                            }
+                        }
+                        line.push('"');
+                    },
+                }
+            }
+            list.push(line);
+        }
+    })
+}
+
+/// The frame's calls: their hash, and their list if asked for. The log goes on from empty.
+pub fn take() -> (u64, Option<Vec<String>>) {
+    LOG.with(|log| {
+        let mut log = log.borrow_mut();
+        let h = hash(&log.bytes);
+        log.bytes.clear();
+        let list = log.list.as_mut().map(std::mem::take);
+        (h, list)
+    })
+}
+
+/// A colour, cut to its 24 bits.
+pub fn colour(c: i32) -> Arg<'static> {
+    Arg::Int(c & 0xFF_FF_FF)
+}
+
+/// The port's `trace::canon::hash`: four lanes, each from its own seed and the length, take turns at the 8-byte
+/// little-endian words (in 32-byte blocks, the last zero-padded), each mixed in by xor, multiply and rotate; then
+/// the lanes are folded together and MurmurHash3's finalizer applied.
+fn hash(bytes: &[u8]) -> u64 {
+    const K: u64 = 0x9e37_79b9_7f4a_7c15;
+    let mix = |h: u64, w: u64| (h ^ w).wrapping_mul(K).rotate_left(31);
+    let fmix = |mut h: u64| {
+        h ^= h >> 33;
+        h = h.wrapping_mul(0xff51_afd7_ed55_8ccd);
+        h ^= h >> 33;
+        h = h.wrapping_mul(0xc4ce_b9fe_1a85_ec53);
+        h ^ (h >> 33)
+    };
+    let len = bytes.len() as u64;
+    let mut lanes = [0x243f_6a88_85a3_08d3u64, 0x1319_8a2e_0370_7344, 0xa409_3822_299f_31d0, 0x082e_fa98_ec4e_6c89];
+    for lane in lanes.iter_mut() {
+        *lane = mix(*lane, len);
+    }
+    let mut block = |b: &[u8]| {
+        for (lane, w) in lanes.iter_mut().zip(b.chunks_exact(8)) {
+            let mut word = [0; 8];
+            word.copy_from_slice(w);
+            *lane = mix(*lane, u64::from_le_bytes(word));
+        }
+    };
+    let blocks = bytes.chunks_exact(32);
+    let rest = blocks.remainder();
+    for b in blocks {
+        block(b);
+    }
+    if !rest.is_empty() {
+        let mut b = [0; 32];
+        b[..rest.len()].copy_from_slice(rest);
+        block(&b);
+    }
+    fmix(lanes.iter().fold(len, |h, &lane| mix(h, fmix(lane))))
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn the_hash_is_the_ports() {
+        // The port's `the_hash_is_fixed` (gm's dump.rs).
+        assert_eq!(super::hash(b""), 0xf4a9_e556_70e1_91bb);
+        assert_eq!(super::hash(b"spelunky"), 0xb42d_3d89_3cbe_d43f);
+    }
+}
