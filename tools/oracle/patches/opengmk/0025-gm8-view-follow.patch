+// Spelunky oracle: one axis of GM8's view following (`Spelunky.exe` 0x4beca4; the port's `View::follow`, probe
+// `view-follow`, 851-3303), in 32-bit integers that wrap: the border rule while twice the border (a wrapping sum) is
+// less than the size, else the view centres on the target; then the clamp to the room, the far edge last; then, with
+// a speed of 0 or more, the move from where the view was limited to that speed. OpenGMK tested `border < size / 2`
+// and limited the speed before the clamp.
+fn gm8_follow(pos: i32, size: i32, border: i32, speed: i32, at: i32, room: i32) -> i32 {
+    let mut new = if border.wrapping_add(border) < size {
+        if at.wrapping_sub(border) < pos {
+            at.wrapping_sub(border)
+        } else if at.wrapping_add(border) > pos.wrapping_add(size) {
+            at.wrapping_add(border).wrapping_sub(size)
+        } else {
+            pos
+        }
+    } else {
+        at.wrapping_sub(size / 2)
+    };
+    new = new.max(0);
+    if room < size.wrapping_add(new) {
+        new = room.wrapping_sub(size);
+    }
+    if speed >= 0 {
+        if new < pos && pos.wrapping_sub(new) > speed {
+            new = pos.wrapping_sub(speed);
+        }
+        if new > pos && new.wrapping_sub(pos) > speed {
+            new = pos.wrapping_add(speed);
+        }
+    }
+    new
+}
