@@ -26,17 +26,19 @@
 impl Real {
     #[inline(always)]
     pub fn sin(self) -> Self {
-        Self(self.0.sin())
+        // Spelunky oracle: the same correctly rounded functions as the port (`gm::math`), instead of the
+        // platform's libm, so both give the same bits. Real GM8 used the x87, which neither reproduces.
+        Self(pxfm::f_sin(self.0))
     }
 
     #[inline(always)]
     pub fn cos(self) -> Self {
-        Self(self.0.cos())
+        Self(pxfm::f_cos(self.0))
     }
 
     #[inline(always)]
     pub fn tan(self) -> Self {
-        Self(self.0.tan())
+        Self(pxfm::f_tan(self.0))
     }
 
