#!/usr/bin/env bash
# Builds the reference oracle: OpenGMK at a pinned commit, patched (patches/), compiled in a Linux container.
#
# Usage: tools/oracle/build
#
# Idempotent. The patched source lives in the cache dir (SPELUNKY_ORACLE_CACHE, default
# ${XDG_CACHE_HOME:-~/.cache}/spelunky-oracle) and is only re-prepared when a pinned commit, a patch or the
# Dockerfile changes. The image build and cargo build are incremental, so a re-run with no changes takes seconds.
set -euo pipefail
# A syntax error anywhere fails it here, before the EXIT trap below can pass it: macOS's bash, 3.2, exits from
# one with the trap's status, 0 (851-3743, as site/test.sh does; scripts/check-sh).
bash -n "$0" || exit 2
# shellcheck source=tools/oracle/common.sh
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

require_docker
command -v git >/dev/null 2>&1 || die "git not found"

image="$(image)"
mkdir -p "$CACHE_DIR"

# Every worktree shares the cache dir and the volumes, so builds take turns.
pxfm="$(mktemp -d)"
# Set where it ends, so a run that stops anywhere before fails, whatever the shell's status says: bash 3.2 exits
# from an error (an unset variable under set -u) with this trap's status, 0 for a cleanup (851-3743).
finished=
cleanup() {
  status=$?
  unlock_all
  rm -rf "$pxfm"
  if [ "$status" -eq 0 ] && [ -z "$finished" ]; then
    echo "tools/oracle/build: stopped before its end, so it fails" >&2
    status=1
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT TERM
lock "$CACHE_DIR/build.lock"

# The stamp covers the vendored math crate as snapshot here, and that snapshot is what goes into the tree, so the
# two can't disagree even if the working tree changes during the build.
pxfm_snapshot "$pxfm"
stamp="$(build_stamp "$pxfm")"

# Clones $1 into $2 (once) and checks out commit $3, fetching if the clone predates it.
checkout() {
  local url="$1" dir="$2" commit="$3"
  if [[ ! -d "$dir/.git" ]]; then
    echo "oracle: cloning $url"
    rm -rf "$dir"
    git clone --quiet --no-checkout "$url" "$dir"
  fi
  if ! git -C "$dir" cat-file -e "$commit^{commit}" 2>/dev/null; then
    git -C "$dir" fetch --quiet origin
  fi
  git -C "$dir" checkout --quiet --force --detach "$commit"
  git -C "$dir" clean --quiet -fdx
  git -C "$dir" submodule --quiet update --init --recursive
}

if [[ "$(cat "$SRC_DIR/.oracle-stamp" 2>/dev/null)" != "$stamp" ]]; then
  echo "oracle: preparing patched source in $SRC_DIR"
  checkout "$OPENGMK_URL" "$SRC_DIR" "$OPENGMK_COMMIT"
  checkout "$RAMEN_URL" "$RAMEN_DIR" "$RAMEN_COMMIT"

  # ramen (OpenGMK's windowing crate) is vendored so it can be patched; patches/opengmk/0001 points cargo at it.
  mkdir "$SRC_DIR/vendor-ramen"
  git -C "$RAMEN_DIR" archive "$RAMEN_COMMIT" | tar -x -C "$SRC_DIR/vendor-ramen"
  for patch in "$ORACLE_DIR"/patches/ramen/*.patch; do
    echo "oracle: applying ramen/$(basename "$patch")"
    git -C "$SRC_DIR" apply --directory=vendor-ramen "$patch"
  done
  # The port's correctly rounded math (vendor/pxfm), so oracle and port compute the same bits; patches/opengmk/0007
  # routes OpenGMK's trigonometry through it.
  # (mkdir, then copy the contents: the snapshot dir itself is mktemp's mode 0700.)
  mkdir "$SRC_DIR/vendor-pxfm"
  cp -R "$pxfm/." "$SRC_DIR/vendor-pxfm/"
  for patch in "$ORACLE_DIR"/patches/opengmk/*.patch; do
    echo "oracle: applying opengmk/$(basename "$patch")"
    git -C "$SRC_DIR" apply "$patch"
  done
  # Patch 0007 adds pxfm to OpenGMK's Cargo.lock, which `--locked` needs. Take its version from the crate itself so
  # the two can't drift apart.
  version="$(pxfm_version "$pxfm")"
  [[ -n "$version" ]] || die "no version in vendor/pxfm/Cargo.toml"
  awk -v v="$version" '
    prev == "name = \"pxfm\"" && /^version = / { $0 = "version = \"" v "\"" }
    { print; prev = $0 }
  ' "$SRC_DIR/Cargo.lock" >"$SRC_DIR/Cargo.lock.tmp"
  mv "$SRC_DIR/Cargo.lock.tmp" "$SRC_DIR/Cargo.lock"
  grep -qx "version = \"$version\"" "$SRC_DIR/Cargo.lock" || die "pxfm missing from OpenGMK's Cargo.lock (patch 0007)"
  echo "$stamp" >"$SRC_DIR/.oracle-stamp"
fi

echo "oracle: building image $image"
docker build --quiet --tag "$image" - <"$ORACLE_DIR/Dockerfile" >/dev/null

# Build, then install the binary under this build's stamp (copied and renamed, so it appears whole).
echo "oracle: building gm8emulator (the first build takes several minutes)"
emulator="$(emulator_path "$stamp")"
docker run --rm \
  --volume "$SRC_DIR:/src:ro" \
  --volume "$CARGO_VOLUME:/cargo" \
  --volume "$TARGET_VOLUME:/target" \
  --workdir /src \
  --env "EMULATOR=$emulator" \
  "$image" \
  bash -c 'set -euo pipefail
    cargo build --release --locked --package gm8emulator
    mkdir -p "$(dirname "$EMULATOR")"
    cp /target/release/gm8emulator "$EMULATOR.tmp"
    mv "$EMULATOR.tmp" "$EMULATOR"'

echo "oracle: ready. Run a replay with tools/oracle/run <replay.txt> <out.jsonl>"
finished=1
