// How the compiler reads number literals: every decimal the game uses, then forms, lengths, integers at the
// top of a binade and hex literals, which tell GM8's digit-by-digit arithmetic from OpenGMK's and from a
// correctly rounded reading (docs/quirks.md).
var p53, h, q;
// floor just below a whole number (hex() relies on it near powers of 2), and 2^53 built exactly.
h = 1; repeat (52) h /= 2;
out("floor_2-2^-52", floor(2 - h));
p53 = 1; repeat (53) p53 *= 2;
// Runtime arithmetic near 2^53 is exact: only the compiler rounds there.
out("ctl_p53-3", p53 - 3);
out("ctl_p53-1", p53 - 1);
q = 900719925474098; q = q * 10 + 9; out("ctl_acc_2^53-3", q);
q = 900719925474099; q = q * 10 + 1; out("ctl_acc_2^53-1", q);

// The game's decimal literals.
out("lit_0.01", 0.01);
out("lit_0.02", 0.02);
out("lit_0.05", 0.05);
out("lit_0.1", 0.1);
out("lit_0.15", 0.15);
out("lit_0.18", 0.18);
out("lit_0.2", 0.2);
out("lit_0.25", 0.25);
out("lit_0.3", 0.3);
out("lit_0.34", 0.34);
out("lit_0.4", 0.4);
out("lit_0.5", 0.5);
out("lit_0.6", 0.6);
out("lit_0.7", 0.7);
out("lit_0.8", 0.8);
out("lit_0.9", 0.9);
out("lit_0.98", 0.98);
out("lit_0.99", 0.99);
out("lit_1.0", 1.0);
out("lit_1.5", 1.5);
out("lit_174.8", 174.8);
out("lit_2.5", 2.5);
out("lit_3.2", 3.2);
out("lit_4.5", 4.5);

// Integer part 4096: the last addition rounds differently to 53 bits and to 64 bits then 53.
out("lit_4096.01509", 4096.01509);
out("lit_4096.05579", 4096.05579);
out("lit_4096.22109", 4096.22109);
out("lit_4096.23219", 4096.23219);
out("lit_4096.32679", 4096.32679);
out("lit_4096.48559", 4096.48559);
out("lit_4096.176095", 4096.176095);
out("lit_4096.0871946", 4096.0871946);

// Forms and lengths.
out("lit_.5", .5);
out("lit_.15", .15);
out("lit_0.30", 0.30);
out("lit_0.300000", 0.300000);
