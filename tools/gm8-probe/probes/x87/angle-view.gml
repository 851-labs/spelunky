// Rotated views (851-3262): window_view_mouse_get_x/y(0) for the mouse at a window position, through
// view 0 rotated by view_angle[0]. GM8 only takes a view's new settings for the mouse after a redraw,
// hence screen_redraw() before each read. Generated by the model described in README.md ("Angles").
// Too long for run-all.
view_enabled = true;
view_visible[0] = true;
view_xport[0] = 0; view_yport[0] = 0; view_wport[0] = 320; view_hport[0] = 240;
view_wview[0] = 160; view_hview[0] = 120;
window_mouse_set(37, 29);
view_xview[0] = 10; view_yview[0] = 20; view_wview[0] = 160; view_hview[0] = 120; view_angle[0] = 0; screen_redraw();
out("vws_0", string(window_view_mouse_get_x(0)) + " " + string(window_view_mouse_get_y(0)));
view_xview[0] = 10; view_yview[0] = 20; view_wview[0] = 160; view_hview[0] = 120; view_angle[0] = (1 / 2); screen_redraw();
