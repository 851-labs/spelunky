self.x = 5; self.x |= "a"; out("selfx_real_or_str", self.x);
self.x = 5; self.x &= "a"; out("selfx_real_and_str", self.x);
self.x = 5; self.x ^= "a"; out("selfx_real_xor_str", self.x);
