// The runner's setters for hspeed, vspeed, speed and direction, and motion_add's update (851-3280). Read from
// Spelunky.exe: hspeed and vspeed store the value and recompute speed and direction (not the other component);
// speed and direction store it and recompute hspeed and vspeed; each skips the write when the value is the one
// already there. direction wraps as d - 360 * floor(d / 360) with Delphi's 32-bit Floor; the update from the
// components gives 0, 90 or 270 when hspeed is 0 and wraps a direction snapped to 360 to 0; motion_add always
// recomputes speed and direction, even when the components didn't change. Values are computed, not written as
// literals where GM8's literal reading would round (0.75 reads as 0.7500000000000001: quirks.md §2).
var k, a, b, p;

a = 0.75; out("lit_0.75", a);
hspeed = 0; vspeed = 0; hspeed = -0.75; vspeed = -0.5;
out("h_lit_-0.75_-0.5", hspeed); out("v_lit_-0.75_-0.5", vspeed); out("s_lit_-0.75_-0.5", speed); out("d_lit_-0.75_-0.5", direction);
hspeed = 0; vspeed = 0; hspeed = 3 / 4 - 0.75; vspeed = 0.5;
out("h_lit_0_0.5", hspeed); out("v_lit_0_0.5", vspeed); out("s_lit_0_0.5", speed); out("d_lit_0_0.5", direction);
for (k = 0; k < 35; k += 1) {
    a = ((k mod 7) - 3) / 4;
    b = (k mod 5) / 3 - 1 / 2;
    hspeed = 0; vspeed = 0; hspeed = a; vspeed = b;
    out("h_hv_" + string(k), hspeed); out("v_hv_" + string(k), vspeed); out("s_hv_" + string(k), speed); out("d_hv_" + string(k), direction);
    hspeed = 0; vspeed = 0; vspeed = b; hspeed = a;
    out("h_vh_" + string(k), hspeed); out("v_vh_" + string(k), vspeed); out("s_vh_" + string(k), speed); out("d_vh_" + string(k), direction);
}
speed = 0; direction = 0; hspeed = 1; vspeed = 0; hspeed = -0;
out("h_zero_-0_0", hspeed); out("v_zero_-0_0", vspeed); out("s_zero_-0_0", speed); out("d_zero_-0_0", direction);
speed = 0; direction = 0; hspeed = 1; vspeed = -0; hspeed = -0;
out("h_zero_-0_-0", hspeed); out("v_zero_-0_-0", vspeed); out("s_zero_-0_-0", speed); out("d_zero_-0_-0", direction);
speed = 0; direction = 0; hspeed = 1; vspeed = -0; hspeed = 0;
out("h_zero_0_-0", hspeed); out("v_zero_0_-0", vspeed); out("s_zero_0_-0", speed); out("d_zero_0_-0", direction);
speed = 0; direction = 0; hspeed = 1; vspeed = 1; hspeed = -0;
out("h_zero_-0_1", hspeed); out("v_zero_-0_1", vspeed); out("s_zero_-0_1", speed); out("d_zero_-0_1", direction);
speed = 0; direction = 0; hspeed = 1; vspeed = -1; hspeed = -0;
out("h_zero_-0_-1", hspeed); out("v_zero_-0_-1", vspeed); out("s_zero_-0_-1", speed); out("d_zero_-0_-1", direction);
speed = 0; direction = 0; hspeed = 0; vspeed = 1; hspeed = 1; vspeed = -0;
out("h_zero_1_-0", hspeed); out("v_zero_1_-0", vspeed); out("s_zero_1_-0", speed); out("d_zero_1_-0", direction);
speed = 0; direction = 0; hspeed = 0; vspeed = 1; hspeed = -1; vspeed = -0;
out("h_zero_-1_-0", hspeed); out("v_zero_-1_-0", vspeed); out("s_zero_-1_-0", speed); out("d_zero_-1_-0", direction);
speed = 0; direction = 0; hspeed = 0; vspeed = 1; hspeed = -1; vspeed = 0;
out("h_zero_-1_0", hspeed); out("v_zero_-1_0", vspeed); out("s_zero_-1_0", speed); out("d_zero_-1_0", direction);
hspeed = 0; vspeed = 0; hspeed = 1; vspeed = 1 / 100000000;
out("h_wrap_1e-8", hspeed); out("v_wrap_1e-8", vspeed); out("s_wrap_1e-8", speed); out("d_wrap_1e-8", direction);
hspeed = 0; vspeed = 0; hspeed = 1; vspeed = 1 / 1000000;
out("h_wrap_1e-6", hspeed); out("v_wrap_1e-6", vspeed); out("s_wrap_1e-6", speed); out("d_wrap_1e-6", direction);
hspeed = 0; vspeed = 0; hspeed = 1; vspeed = 1 / 1000;
out("h_wrap_1e-3", hspeed); out("v_wrap_1e-3", vspeed); out("s_wrap_1e-3", speed); out("d_wrap_1e-3", direction);
hspeed = 0; vspeed = 0; hspeed = 1; vspeed = -1 / 100000000;
out("h_wrap_-1e-8", hspeed); out("v_wrap_-1e-8", vspeed); out("s_wrap_-1e-8", speed); out("d_wrap_-1e-8", direction);
hspeed = 0; vspeed = 0; hspeed = 3 / 10; vspeed = 7 / 10;
out("h_same_0", hspeed); out("v_same_0", vspeed); out("s_same_0", speed); out("d_same_0", direction);
speed = speed;
out("h_same_speed", hspeed); out("v_same_speed", vspeed); out("s_same_speed", speed); out("d_same_speed", direction);
direction = direction;
out("h_same_dir", hspeed); out("v_same_dir", vspeed); out("s_same_dir", speed); out("d_same_dir", direction);
a = direction; direction = a + 360;
out("h_same_dir+360", hspeed); out("v_same_dir+360", vspeed); out("s_same_dir+360", speed); out("d_same_dir+360", direction);
hspeed = 0; vspeed = 0; hspeed = 3 / 10; vspeed = 7 / 10; a = speed; speed = a * 2; speed = a;
out("h_same_speed2", hspeed); out("v_same_speed2", vspeed); out("s_same_speed2", speed); out("d_same_speed2", direction);
hspeed = 0; vspeed = 0; hspeed = 3 / 10; vspeed = 7 / 10; hspeed = 3 / 10;
out("h_same_h", hspeed); out("v_same_h", vspeed); out("s_same_h", speed); out("d_same_h", direction);
speed = 0; direction = 0; speed = 0;
out("h_same_rest", hspeed); out("v_same_rest", vspeed); out("s_same_rest", speed); out("d_same_rest", direction);
p = 1; repeat (31) p = p * 2;
speed = 0; direction = 0; speed = 2; direction = -90;
out("h_dir_-90", hspeed); out("v_dir_-90", vspeed); out("s_dir_-90", speed); out("d_dir_-90", direction);
speed = 0; direction = 0; speed = 2; direction = 360;
out("h_dir_360", hspeed); out("v_dir_360", vspeed); out("s_dir_360", speed); out("d_dir_360", direction);
speed = 0; direction = 0; speed = 2; direction = 720;
out("h_dir_720", hspeed); out("v_dir_720", vspeed); out("s_dir_720", speed); out("d_dir_720", direction);
speed = 0; direction = 0; speed = 2; direction = -360;
out("h_dir_-360", hspeed); out("v_dir_-360", vspeed); out("s_dir_-360", speed); out("d_dir_-360", direction);
speed = 0; direction = 0; speed = 2; direction = -0;
out("h_dir_-0", hspeed); out("v_dir_-0", vspeed); out("s_dir_-0", speed); out("d_dir_-0", direction);
speed = 0; direction = 0; speed = 2; direction = -1 / 1152921504606846976;
out("h_dir_-2p-60", hspeed); out("v_dir_-2p-60", vspeed); out("s_dir_-2p-60", speed); out("d_dir_-2p-60", direction);
speed = 0; direction = 0; speed = 2; direction = 1000 + 1 / 2;
out("h_dir_1000.5", hspeed); out("v_dir_1000.5", vspeed); out("s_dir_1000.5", speed); out("d_dir_1000.5", direction);
speed = 0; direction = 0; speed = 2; direction = -1000 - 1 / 2;
out("h_dir_-1000.5", hspeed); out("v_dir_-1000.5", vspeed); out("s_dir_-1000.5", speed); out("d_dir_-1000.5", direction);
speed = 0; direction = 0; speed = 2; direction = 360 * p + 90;
out("h_dir_360x2p31+90", hspeed); out("v_dir_360x2p31+90", vspeed); out("s_dir_360x2p31+90", speed); out("d_dir_360x2p31+90", direction);
speed = 0; direction = 0; speed = 2; direction = 360 * p - 90;
out("h_dir_360x2p31-90", hspeed); out("v_dir_360x2p31-90", vspeed); out("s_dir_360x2p31-90", speed); out("d_dir_360x2p31-90", direction);
speed = 0; direction = 0; speed = 2; direction = -360 * p - 90;
out("h_dir_-360x2p31-90", hspeed); out("v_dir_-360x2p31-90", vspeed); out("s_dir_-360x2p31-90", speed); out("d_dir_-360x2p31-90", direction);
speed = 0; direction = 0; speed = 2; direction = 360 * p * 2 + 90;
out("h_dir_360x2p32+90", hspeed); out("v_dir_360x2p32+90", vspeed); out("s_dir_360x2p32+90", speed); out("d_dir_360x2p32+90", direction);
speed = 0; direction = 0; speed = 2; direction = 360 * p * 512 + 90;
out("h_dir_360x2p40+90", hspeed); out("v_dir_360x2p40+90", vspeed); out("s_dir_360x2p40+90", speed); out("d_dir_360x2p40+90", direction);
p = 1; repeat (60) p = p / 2;
speed = 0; direction = 0; speed = 3; direction = 45 + 3 / 10;
out("h_am0_0", hspeed); out("v_am0_0", vspeed); out("s_am0_0", speed); out("d_am0_0", direction);
motion_add(0, 0);
out("h_am_0", hspeed); out("v_am_0", vspeed); out("s_am_0", speed); out("d_am_0", direction);
speed = 0; direction = 0; speed = 3; direction = 45 + 3 / 10;
motion_add(0, p);
out("h_amp_0", hspeed); out("v_amp_0", vspeed); out("s_amp_0", speed); out("d_amp_0", direction);
speed = 0; direction = 0; speed = 7; direction = 10 + 1 / 10;
out("h_am0_1", hspeed); out("v_am0_1", vspeed); out("s_am0_1", speed); out("d_am0_1", direction);
motion_add(0, 0);
out("h_am_1", hspeed); out("v_am_1", vspeed); out("s_am_1", speed); out("d_am_1", direction);
speed = 0; direction = 0; speed = 7; direction = 10 + 1 / 10;
motion_add(0, p);
out("h_amp_1", hspeed); out("v_amp_1", vspeed); out("s_amp_1", speed); out("d_amp_1", direction);
speed = 0; direction = 0; speed = 5; direction = 200 + 7 / 10;
out("h_am0_2", hspeed); out("v_am0_2", vspeed); out("s_am0_2", speed); out("d_am0_2", direction);
motion_add(0, 0);
out("h_am_2", hspeed); out("v_am_2", vspeed); out("s_am_2", speed); out("d_am_2", direction);
speed = 0; direction = 0; speed = 5; direction = 200 + 7 / 10;
motion_add(0, p);
out("h_amp_2", hspeed); out("v_amp_2", vspeed); out("s_amp_2", speed); out("d_amp_2", direction);
speed = 0; direction = 0; speed = 1 / 3; direction = 33 + 1 / 3;
out("h_am0_3", hspeed); out("v_am0_3", vspeed); out("s_am0_3", speed); out("d_am0_3", direction);
motion_add(0, 0);
out("h_am_3", hspeed); out("v_am_3", vspeed); out("s_am_3", speed); out("d_am_3", direction);
speed = 0; direction = 0; speed = 1 / 3; direction = 33 + 1 / 3;
motion_add(0, p);
out("h_amp_3", hspeed); out("v_amp_3", vspeed); out("s_amp_3", speed); out("d_amp_3", direction);
speed = 0; direction = 0; speed = 2; direction = 123 + 4 / 10;
out("h_am0_4", hspeed); out("v_am0_4", vspeed); out("s_am0_4", speed); out("d_am0_4", direction);
motion_add(0, 0);
out("h_am_4", hspeed); out("v_am_4", vspeed); out("s_am_4", speed); out("d_am_4", direction);
speed = 0; direction = 0; speed = 2; direction = 123 + 4 / 10;
motion_add(0, p);
out("h_amp_4", hspeed); out("v_amp_4", vspeed); out("s_amp_4", speed); out("d_amp_4", direction);
speed = 0; direction = 0; speed = 9; direction = 300 + 1 / 7;
out("h_am0_5", hspeed); out("v_am0_5", vspeed); out("s_am0_5", speed); out("d_am0_5", direction);
motion_add(0, 0);
out("h_am_5", hspeed); out("v_am_5", vspeed); out("s_am_5", speed); out("d_am_5", direction);
speed = 0; direction = 0; speed = 9; direction = 300 + 1 / 7;
motion_add(0, p);
out("h_amp_5", hspeed); out("v_amp_5", vspeed); out("s_amp_5", speed); out("d_amp_5", direction);
speed = 0;
