// The lines of `numbers` after floor(1e20), and of `ops` without a NaN, an infinity or an operand past the
// Int64 range, under the same names: on GM8 on a real Intel CPU (and on the oracle) those stop the other two
// probes (the x87 traps), and nothing here should.
var eps, big, nz, p31, p32, p62, p63;
eps = 1; repeat (14) eps /= 10;
big = 1099511627776;
out("ceil_2p40+0.5", ceil(big + 0.5));
out("ceil_-0.5", ceil(-0.5));
out("frac_2p40+0.25", frac(big + 0.25));
out("frac_-1.25", frac(-1.25));
out("sign_1e-14", sign(eps));
out("abs_-0", abs(-0));

// string() of reals: ties at the third decimal, -0, big and tiny values
nz = 0 * -1;
out("neg_zero", nz);
out("str_0.125", string(0.125));
out("str_0.375", string(0.375));
out("str_0.625", string(0.625));
out("str_-0.125", string(-0.125));
out("str_2.5", string(2.5));
out("str_-0.5", string(-0.5));
out("str_-0", string(nz));
out("str_-0.004", string(-0.004));
out("str_-0.005", string(-0.005));
out("str_0.005", string(0.005));
out("str_0.015", string(0.015));
out("str_1.005", string(1.005));
out("str_2.675", string(2.675));
out("str_0.995", string(0.995));
out("str_99.995", string(99.995));
out("str_1/3", string(1 / 3));
out("str_2p40", string(big));
out("str_2p40+0.5", string(big + 0.5));
out("str_1e15", string(1000000000000000));
out("str_1e15+0.3", string(1000000000000000 + 0.3));
out("str_2p53", string(big * 8192));
out("str_1e20", string(big * big * 100));
out("str_1e-5", string(eps * 1000000000));
out("str_-1e-14", string(-eps));
out("str_int_string", string(12) + "|" + string(-3));

// string <-> real conversions that should work on any reading
out("real_12", real("12"));
out("real_ 12 ", real(" 12 "));
out("real_1.5", real("1.5"));
out("real_-0", real("-0"));
out("real_empty", real(""));
out("real_.5", real(".5"));
out("real_+3", real("+3"));
out("real_0.1", real("0.1"));
out("real_0.3", real("0.3"));
out("lit_0.3", 0.3);
out("lit_0.1", 0.1);
out("real_1e3", real("1e3"));

// Bitwise operators: operands are rounded to integers; what width?
out("and_5_3", 5 & 3);
out("and_-1_255", (-1) & 255);
out("or_-5_2", (-5) | 2);
out("xor_-5_1", (-5) ^ 1);
out("and_3.7_1", 3.7 & 1);
out("and_2.5_3", 2.5 & 3);
out("or_-2.5_0", (-2.5) | 0);
out("or_2p31_0", 2147483648 | 0);
out("or_2p32+5_0", 4294967301 | 0);
out("or_2p40_1", big | 1);
out("shl_1_31", 1 << 31);
out("shl_1_32", 1 << 32);
out("shl_1_40", 1 << 40);
out("shr_-1_1", (-1) >> 1);
out("shr_2p31_1", 2147483648 >> 1);
out("shr_-8_1", (-8) >> 1);

// div and mod with nonzero divisors
out("div_7_2", 7 div 2);
out("div_-7_2", (-7) div 2);
out("div_7_-2", 7 div -2);
out("div_7.5_2", 7.5 div 2);
out("div_2p40+1_3", (big + 1) div 3);
out("mod_-7_3", (-7) mod 3);
out("mod_7_-3", 7 mod -3);
out("mod_5.5_2", 5.5 mod 2);
out("mod_-5.5_2", (-5.5) mod 2);
out("mod_1_0.1", 1 mod 0.1);
out("mod_2p40+3_7", (big + 3) mod 7);

p31 = 2147483648;
p32 = 4294967296;
p62 = p31 * p31;
p63 = p62 * 2;
big = p62 * p62;
out("o_floor_2p31-1", floor(p31 - 1));
out("o_floor_-2p31", floor(-p31));
out("o_floor_-2p31+0.5", floor(-p31 + 0.5));
out("o_floor_2p32-0.5", floor(p32 - 0.5));
out("o_floor_2p32+2p31+0.5", floor(p32 + p31 + 0.5));
out("o_floor_-2p63", floor(-p63));
out("o_floor_2p62+3", floor(p62 + 4096));
out("o_floor_-0.5", floor(-0.5));
out("o_floor_-0", floor(-0.0 * 1));
out("o_floor_3", floor(3));
out("o_floor_-3", floor(-3));
out("o_ceil_2p31-0.5", ceil(p31 - 0.5));
out("o_ceil_-2p31-0.5", ceil(-p31 - 0.5));
out("o_ceil_2p32+0.5", ceil(p32 + 0.5));
out("o_ceil_3", ceil(3));
out("o_round_2p32+0.5", round(p32 + 0.5));
out("o_round_2p62+1", round(p62 + 1024));
out("o_round_-2p63", round(-p63));
out("o_round_-0.5", round(-0.5));
out("o_round_-1.5", round(-1.5));
out("o_frac_2p63+", frac(p63 + 2048));
out("o_frac_-0.5", frac(-0.5));
// div and mod
out("o_div_-7.5_2", (-7.5) div 2);
out("o_div_7_2.5", 7 div 2.5);
out("o_div_-1_3", (-1) div 3);
out("o_div_2p31_1", p31 div 1);
out("o_div_2p32+5_1", (p32 + 5) div 1);
out("o_div_-2p31-1_1", (-p31 - 1) div 1);
out("o_div_2p40_0.5", (p32 * 256) div 0.5);
out("o_mod_7_2.5", 7 mod 2.5);
out("o_mod_-7_2.5", (-7) mod 2.5);
out("o_mod_7_-2.5", 7 mod -2.5);
out("o_mod_7_0.5", 7 mod 0.5);
out("o_mod_5.25_0.5", 5.25 mod 0.5);
out("o_mod_2p31+1_2p31", (p31 + 1) mod p31);
out("o_mod_2p32+5_3", (p32 + 5) mod 3);
out("o_mod_0.3_0.1", 0.3 mod 0.1);
// bitwise
out("b_and_-0.5_7", (-0.5) & 7);
out("b_and_-1.5_7", (-1.5) & 7);
out("b_and_-2.5_7", (-2.5) & 7);
out("b_and_0.5_1", 0.5 & 1);
out("b_and_1.5_3", 1.5 & 3);
out("b_or_-2p63_0", (-p63) | 0);
out("b_or_2p63-1024_0", (p63 - 1024) | 0);
out("b_xor_-1_-1", (-1) ^ (-1));
out("b_xor_-1_0", (-1) ^ 0);
out("b_and_-1_-2p62", (-1) & (-p62));
out("b_not_0", ~0);
out("b_not_5", ~5);
out("b_not_-1", ~(-1));
out("b_not_2.5", ~2.5);
out("b_shl_1_62", 1 << 62);
out("b_shl_1_63", 1 << 63);
out("b_shl_1_64", 1 << 64);
out("b_shl_1_65", 1 << 65);
out("b_shl_3_62", 3 << 62);
out("b_shl_1_-1", 1 << -1);
out("b_shl_1_100", 1 << 100);
out("b_shl_1_255", 1 << 255);
out("b_shl_1_256", 1 << 256);
out("b_shl_1_257", 1 << 257);
out("b_shl_1_0.5", 1 << 0.5);
out("b_shl_1_1.5", 1 << 1.5);
out("b_shl_-1_1", (-1) << 1);
out("b_shl_5_2.5", 5 << 2.5);
out("b_shr_-1_0", (-1) >> 0);
out("b_shr_-1_63", (-1) >> 63);
out("b_shr_-1_64", (-1) >> 64);
out("b_shr_-1_65", (-1) >> 65);
out("b_shr_-2_1", (-2) >> 1);
out("b_shr_-1_32", (-1) >> 32);
out("b_shr_-1_-1", (-1) >> -1);
out("b_shr_256_1.5", 256 >> 1.5);
out("b_shr_2p62_62", p62 >> 62);
out("b_shr_-2p63_63", (-p63) >> 63);
out("b_shr_-1_300", (-1) >> 300);
