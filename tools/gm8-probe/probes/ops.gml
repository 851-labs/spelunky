// NaN and infinity comparisons from both sides, floor/ceil/round/frac/div/mod past 2^31, 2^32 and 2^63, and
// bitwise operators on fractions, negatives and big values. Nothing here should error on GM8.
var pinf, ninf, nan, big, p31, p32, p62, p63, v;
pinf = exp(1000);
ninf = -pinf;
nan = power(-8, 1 / 3);
out("o_0_lt_nan", 0 < nan);
out("o_0_le_nan", 0 <= nan);
out("o_0_gt_nan", 0 > nan);
out("o_0_ge_nan", 0 >= nan);
out("o_0_eq_nan", 0 == nan);
out("o_0_ne_nan", 0 != nan);
out("o_nan_le_nan", nan <= nan);
out("o_nan_ge_nan", nan >= nan);
out("o_inf_lt_inf", pinf < pinf);
out("o_inf_ge_inf", pinf >= pinf);
out("o_ninf_le_ninf", ninf <= ninf);
out("o_inf_gt_ninf", pinf > ninf);
out("o_not_nan", !nan);
out("o_nan_and_1", nan && 1);
out("o_nan_or_0", nan || 0);
v = 0; while (nan) { v += 1; if (v > 2) break; } out("o_while_nan", v);
out("o_sign_nan", sign(nan));
out("o_abs_nan_ge0", abs(nan) >= 0);
out("o_max_nan_1", max(nan, 1));
out("o_min_nan_1", min(nan, 1));
out("o_nan_eq_str", string(nan == 1));
out("o_sqrt_-4_eq", sqrt(-4) == 0);
p31 = 2147483648;
p32 = 4294967296;
p62 = p31 * p31;
p63 = p62 * 2;
big = p62 * p62;
out("o_floor_2p31-1", floor(p31 - 1));
out("o_floor_-2p31", floor(-p31));
out("o_floor_-2p31+0.5", floor(-p31 + 0.5));
out("o_floor_2p32-0.5", floor(p32 - 0.5));
out("o_floor_2p32+2p31+0.5", floor(p32 + p31 + 0.5));
out("o_floor_2p63", floor(p63));
out("o_floor_-2p63", floor(-p63));
out("o_floor_2p62+3", floor(p62 + 4096));
out("o_floor_nan", floor(nan));
out("o_floor_ninf", floor(ninf));
out("o_floor_-0.5", floor(-0.5));
out("o_floor_-0", floor(-0.0 * 1));
out("o_floor_3", floor(3));
out("o_floor_-3", floor(-3));
out("o_ceil_2p31-0.5", ceil(p31 - 0.5));
out("o_ceil_-2p31-0.5", ceil(-p31 - 0.5));
out("o_ceil_2p32+0.5", ceil(p32 + 0.5));
out("o_ceil_nan", ceil(nan));
out("o_ceil_inf", ceil(pinf));
out("o_ceil_3", ceil(3));
out("o_round_2p32+0.5", round(p32 + 0.5));
out("o_round_2p62+1", round(p62 + 1024));
out("o_round_2p63", round(p63));
out("o_round_-2p63", round(-p63));
out("o_round_2p64", round(p63 * 2));
out("o_round_1e20", round(big));
out("o_round_nan", round(nan));
out("o_round_ninf", round(ninf));
out("o_round_-0.5", round(-0.5));
out("o_round_-1.5", round(-1.5));
out("o_frac_2p63+", frac(p63 + 2048));
out("o_frac_nan", frac(nan));
out("o_frac_inf", frac(pinf));
out("o_frac_-0.5", frac(-0.5));
// div and mod
out("o_div_-7.5_2", (-7.5) div 2);
out("o_div_7_2.5", 7 div 2.5);
out("o_div_-1_3", (-1) div 3);
out("o_div_2p31_1", p31 div 1);
out("o_div_2p32+5_1", (p32 + 5) div 1);
out("o_div_-2p31-1_1", (-p31 - 1) div 1);
out("o_div_2p63_1", p63 div 1);
out("o_div_2p40_0.5", (p32 * 256) div 0.5);
out("o_div_inf_2", pinf div 2);
out("o_div_nan_2", nan div 2);
out("o_mod_7_2.5", 7 mod 2.5);
out("o_mod_-7_2.5", (-7) mod 2.5);
out("o_mod_7_-2.5", 7 mod -2.5);
out("o_mod_7_0.5", 7 mod 0.5);
out("o_mod_5.25_0.5", 5.25 mod 0.5);
out("o_mod_2p31+1_2p31", (p31 + 1) mod p31);
out("o_mod_2p32+5_3", (p32 + 5) mod 3);
out("o_mod_2p63_3", p63 mod 3);
out("o_mod_inf_2", pinf mod 2);
out("o_mod_nan_2", nan mod 2);
out("o_mod_2_inf", 2 mod pinf);
out("o_div_2_inf", 2 div pinf);
out("o_mod_0.3_0.1", 0.3 mod 0.1);
// bitwise
out("b_and_-0.5_7", (-0.5) & 7);
out("b_and_-1.5_7", (-1.5) & 7);
out("b_and_-2.5_7", (-2.5) & 7);
out("b_and_0.5_1", 0.5 & 1);
out("b_and_1.5_3", 1.5 & 3);
out("b_or_-2p63_0", (-p63) | 0);
out("b_or_2p63_0", p63 | 0);
out("b_or_2p63-1024_0", (p63 - 1024) | 0);
out("b_or_2p64_0", (p63 * 2) | 0);
out("b_or_nan_0", nan | 0);
out("b_or_ninf_0", ninf | 0);
out("b_xor_-1_-1", (-1) ^ (-1));
out("b_xor_-1_0", (-1) ^ 0);
out("b_and_-1_-2p62", (-1) & (-p62));
out("b_not_0", ~0);
out("b_not_5", ~5);
out("b_not_-1", ~(-1));
out("b_not_2.5", ~2.5);
out("b_not_2p63", ~p63);
out("b_shl_1_62", 1 << 62);
out("b_shl_1_63", 1 << 63);
out("b_shl_1_64", 1 << 64);
out("b_shl_1_65", 1 << 65);
out("b_shl_3_62", 3 << 62);
out("b_shl_1_-1", 1 << -1);
out("b_shl_1_100", 1 << 100);
out("b_shl_1_255", 1 << 255);
out("b_shl_1_256", 1 << 256);
out("b_shl_1_257", 1 << 257);
out("b_shl_1_0.5", 1 << 0.5);
out("b_shl_1_1.5", 1 << 1.5);
out("b_shl_-1_1", (-1) << 1);
out("b_shl_5_2.5", 5 << 2.5);
out("b_shr_-1_0", (-1) >> 0);
out("b_shr_-1_63", (-1) >> 63);
out("b_shr_-1_64", (-1) >> 64);
out("b_shr_-1_65", (-1) >> 65);
out("b_shr_-2_1", (-2) >> 1);
out("b_shr_-1_32", (-1) >> 32);
out("b_shr_-1_-1", (-1) >> -1);
out("b_shr_256_1.5", 256 >> 1.5);
out("b_shr_2p62_62", p62 >> 62);
out("b_shr_-2p63_63", (-p63) >> 63);
out("b_shr_-1_300", (-1) >> 300);
