// string_format(x, total, decimals): rounding, padding, big values and -0 (infinities and NaN: string-format-nonfinite).
var v, k, nz;
nz = 0 * -1;
k = 1; repeat (14) k /= 10;
v = 1; repeat (3) v /= 2; // 0.125
out("sf_0.125_0_2", "[" + string_format(v, 0, 2) + "]");
out("sf_0.125_10_2", "[" + string_format(v, 10, 2) + "]");
out("sf_0.125_0_1", "[" + string_format(v, 0, 1) + "]");
out("sf_0.625_0_2", "[" + string_format(5 * v, 0, 2) + "]");
out("sf_-0.125_0_2", "[" + string_format(-v, 0, 2) + "]");
out("sf_-0.001_0_2", "[" + string_format(-0.001, 0, 2) + "]");
out("sf_-0_0_2", "[" + string_format(nz, 0, 2) + "]");
out("sf_-0_0_0", "[" + string_format(nz, 0, 0) + "]");
out("sf_0.5_0_0", "[" + string_format(0.5, 0, 0) + "]");
out("sf_1.5_0_0", "[" + string_format(1.5, 0, 0) + "]");
out("sf_2.5_0_0", "[" + string_format(2.5, 0, 0) + "]");
out("sf_-0.5_0_0", "[" + string_format(-0.5, 0, 0) + "]");
out("sf_12_5_0", "[" + string_format(12, 5, 0) + "]");
out("sf_12_0_2", "[" + string_format(12, 0, 2) + "]");
out("sf_-12_8_3", "[" + string_format(-12, 8, 3) + "]");
out("sf_1234.5678_3_1", "[" + string_format(1234.5678, 3, 1) + "]");
out("sf_1/3_0_5", "[" + string_format(1 / 3, 0, 5) + "]");
out("sf_1/3_0_15", "[" + string_format(1 / 3, 0, 15) + "]");
out("sf_1/3_0_18", "[" + string_format(1 / 3, 0, 18) + "]");
out("sf_1/3_0_25", "[" + string_format(1 / 3, 0, 25) + "]");
out("sf_2/3_0_0", "[" + string_format(2 / 3, 0, 0) + "]");
out("sf_123.456_0_-1", "[" + string_format(123.456, 0, -1) + "]");
out("sf_123.456_0_-2", "[" + string_format(123.456, 0, -2) + "]");
out("sf_12345678901.5_0_2", "[" + string_format(12345678901.5, 0, 2) + "]");
out("sf_123456789012345.5_0_1", "[" + string_format(123456789012345.5, 0, 1) + "]");
out("sf_1e15_0_2", "[" + string_format(1000000000000000, 0, 2) + "]");
out("sf_1e20_0_2", "[" + string_format(100000000000000000000, 0, 2) + "]");
out("sf_1e-5_0_6", "[" + string_format(k * 1000000000, 0, 6) + "]");
out("sf_1e-14_0_20", "[" + string_format(k, 0, 20) + "]");
out("sf_99.995_0_2", "[" + string_format(99.995, 0, 2) + "]");
out("sf_0.015_0_2", "[" + string_format(0.015, 0, 2) + "]");
out("sf_123456.785_0_2", "[" + string_format(123456.785, 0, 2) + "]");
out("sf_12345678.125_0_2", "[" + string_format(12345678.125, 0, 2) + "]");
out("sf_7_-3_2", "[" + string_format(7, -3, 2) + "]");
out("sf_str_5_2", "[" + string_format("ab", 5, 2) + "]");
out("sf_2.5_1.5_0.5", "[" + string_format(2.5, 1.5, 0.5) + "]");
