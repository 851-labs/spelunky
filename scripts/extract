#!/bin/sh
# Regenerates assets/ (gitignored) from the reference zips: the game's bundle, and the settings program's
# (config.gmk) in assets/config/. Extra arguments go to the extractor, for both.
set -eu
cd "$(dirname "$0")/.."
scripts/cargo run --quiet --release -p tools --bin extract -- --reference reference --out assets "$@"
exec scripts/cargo run --quiet --release -p tools --bin extract -- --reference reference --out assets/config \
  --program config "$@"
