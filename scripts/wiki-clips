#!/bin/sh
# Renders the wiki's clips (wiki/clips/*/*.toml) into target/wiki-media/clips (gitignored): checks each spec's
# story facts on the port, has the app capture its frames with the copyright notice burned into the first
# two seconds, and encodes them with ffmpeg (brew install ffmpeg) to MP4 and WebM, with a poster and JSON
# metadata. Run scripts/extract first. `--check` only checks the specs (what scripts/check runs); `--replays
# DIR` also writes each scene's replay, for replay-story; spec paths render only those. docs/wiki-media.md
# has the format and the layout.
set -eu
cd "$(dirname "$0")/.."
scripts/cargo build --quiet --release -p app -p harness --bin app --bin wiki-clips
# The caption names the port's version the clips were recorded with.
version=$(git describe --tags --always 2>/dev/null || echo unreleased)
exec target/release/wiki-clips --app target/release/app --port-version "$version" "$@"
