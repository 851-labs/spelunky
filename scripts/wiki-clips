#!/bin/sh
# Checks or renders the wiki's clips (wiki/clips/*/*.toml; docs/wiki-media.md, "Clips"): `--check` only checks
# the specs' story facts, as scripts/check does (needing neither the app's GPU nor ffmpeg), and `--replays DIR`
# also writes each scene's replay, for replay-story; `--out DIR SPEC...` renders those specs into DIR, to look
# at them, with the pinned ffmpeg (scripts/release/tools). scripts/wiki-media renders them into wiki/media,
# the sprites too, which is what to commit. Run scripts/extract first.
set -eu
# Not cd'ing, so paths in the arguments stay relative to where it was run.
root=$(cd "$(dirname "$0")/.." && pwd)
bin=${CARGO_TARGET_DIR:-$root/target}/release
case " $* " in
  *" --check "*)
    "$root/scripts/cargo" build --quiet --release --manifest-path "$root/Cargo.toml" -p harness --bin wiki-clips
    exec "$bin/wiki-clips" "$@"
    ;;
esac
"$root/scripts/cargo" build --quiet --release --manifest-path "$root/Cargo.toml" -p app -p harness \
  --bin app --bin wiki-clips
"$root/scripts/release/tools" ffmpeg
ffmpeg=${SPELUNKY_RELEASE_TOOLS:-$root/target/release-tools}/ffmpeg-$(sed -n 's/^FFMPEG=//p' "$root/scripts/release/tools")/ffmpeg
exec "$bin/wiki-clips" --app "$bin/app" --ffmpeg "$ffmpeg" "$@"
