#!/bin/sh
# Exports the wiki's sprite media (frames, strips, APNG previews and JSON metadata) from assets/ into
# wiki/media/sprites. Run scripts/extract first; scripts/wiki-media runs this, with the clips. `--assets DIR`,
# `--out DIR` and `--scale N` (the upscaled copies' factor, default 4) override the defaults.
# docs/wiki-media.md has the layout.
set -eu
cd "$(dirname "$0")/.."
exec scripts/cargo run --quiet --release -p tools --bin wiki-sprites -- \
  --assets assets --out wiki/media/sprites "$@"
