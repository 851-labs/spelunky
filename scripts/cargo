#!/bin/sh
# Runs cargo through rustup's proxies so rust-toolchain.toml (and its wasm32 target) applies,
# even when a Homebrew `rust` install shadows rustup on PATH. CARGO_HOME's proxies come first, if it has
# them (CI installs rustup into the runner's tool cache).
set -eu
if [ -n "${CARGO_HOME:-}" ] && [ -x "$CARGO_HOME/bin/cargo" ]; then
  proxies="$CARGO_HOME/bin"
elif [ -x "$HOME/.cargo/bin/cargo" ]; then
  proxies="$HOME/.cargo/bin"
elif command -v brew >/dev/null 2>&1 && [ -x "$(brew --prefix rustup 2>/dev/null)/bin/cargo" ]; then
  proxies="$(brew --prefix rustup)/bin"
else
  echo "scripts/cargo: rustup's cargo proxy not found; install rustup" >&2
  exit 1
fi
# A linked worktree's first build starts from the main worktree's target/ (scripts/seed-target): for the
# commands that build, the first argument that isn't a flag or a +toolchain. Not for the rest (fmt, clean,
# metadata), so scripts/check --fast's formatting check stays instant. The global flags that take a value
# skip it; another's value read as the command only skips the seeding.
value=
for arg in "$@"; do
  [ -z "$value" ] || { value=; continue; }
  case $arg in
    -C | --config | -Z | --color | --manifest-path) value=1; continue ;;
    -* | +*) continue ;;
    build | b | check | c | test | t | run | r | bench | clippy | doc | d | rustc | rustdoc | fix)
      "$(dirname "$0")/seed-target" || true ;;
  esac
  break
done
PATH="$proxies:$PATH" exec cargo "$@"
