#!/bin/sh
# scripts/release/auto's tests (scripts/check runs them): what counts for a release, when it starts, and the
# tag it gets, in a scratch repository.
set -eu
# A syntax error anywhere fails it here, before the EXIT trap below can pass it: macOS's sh, bash 3.2, exits from
# one with the trap's status, 0 (851-3743, as site/test.sh does; scripts/check-sh).
sh -n "$0" || exit 2
script=$(cd "$(dirname "$0")" && pwd)/auto
tmp=$(mktemp -d)
# Set where it ends, so a run that stops anywhere before fails, whatever the shell's status says: bash 3.2 exits
# from an error (an unset variable under set -u) with this trap's status, 0 for a cleanup (851-3743).
finished=
cleanup() {
  status=$?
  rm -rf "$tmp"
  if [ "$status" -eq 0 ] && [ -z "$finished" ]; then
    echo "scripts/release/auto-test: stopped before its end, so it fails" >&2
    status=1
  fi
  exit "$status"
}
trap cleanup EXIT
cd "$tmp"
git init -q -b main
git config user.name test
git config user.email test@example.com
git config tag.gpgSign false
git config commit.gpgSign false
mkdir -p scripts/release
cp "$script" scripts/release/auto
auto=scripts/release/auto
failures=0
check() { # NAME EXPECTED ACTUAL
  if [ "$2" = "$3" ]; then echo "ok $1"; else printf 'FAIL %s\n  expected: %s\n  got:      %s\n' "$1" "$2" "$3" >&2; failures=$((failures + 1)); fi
}
# A commit at the time $1 (seconds) touching each of the other arguments.
commit_at() {
  t=$1
  shift
  for f in "$@"; do mkdir -p "$(dirname "$f")"; echo "$t" >>"$f"; done
  git add -A
  GIT_COMMITTER_DATE="@$t +0000" GIT_AUTHOR_DATE="@$t +0000" git commit -q -m "at $t"
}
plan() { NOW=$1 $auto plan HEAD 2>/dev/null | tr '\n' ' '; }

commit_at 1000 crates/game/src/lib.rs
git tag -a v0.1.9 -m v0.1.9
git tag -a v0.1.10-rc1 -m rc
check "a released commit keeps its tag" v0.1.9 "$($auto tag HEAD)"
check "nothing to release" "base=v0.1.9 covered=v0.1.9 changes=0 release=false wait=0 " "$(plan 1000)"

# Neither docs, the site, the wiki, the harness, tests, Markdown nor the wiki's tools.
commit_at 2000 docs/ci.md site/web-release.txt wiki/clips/a.json crates/harness/src/lib.rs \
  crates/game/tests/smoke.rs crates/game/README.md crates/tools/src/bin/wiki-data/main.rs \
  crates/tools/src/bin/wiki-cites.rs .github/workflows/release.yml scripts/release/auto-test
check "only what isn't released" "base=v0.1.9 covered= changes=0 release=false wait=0 " "$(plan 2000)"
check "the next patch, past the prerelease" v0.1.10 "$($auto tag HEAD)"

commit_at 3000 crates/game/src/lib.rs
check "a change: wait for quiet" "base=v0.1.9 covered= changes=1 release=true wait=600 " "$(plan 3000)"
check "a change, quiet already" "base=v0.1.9 covered= changes=1 release=true wait=0 " "$(plan 3700)"
commit_at 3500 vendor/pxfm/src/lib.rs scripts/web Cargo.lock crates/tools/src/bin/extract.rs
check "another change restarts the wait" "base=v0.1.9 covered= changes=5 release=true wait=600 " "$(plan 3500)"
commit_at 4700 reference/SHA256SUMS
check "but never past 30 minutes after the first" "base=v0.1.9 covered= changes=6 release=true wait=100 " \
  "$(plan 4700)"
commit_at 4750 docs/a.md
check "a merge of anything else doesn't move it" "base=v0.1.9 covered= changes=6 release=true wait=50 " \
  "$(plan 4750)"
check "the changes" "Cargo.lock crates/game/src/lib.rs crates/tools/src/bin/extract.rs reference/SHA256SUMS scripts/web vendor/pxfm/src/lib.rs " \
  "$($auto changes v0.1.9 HEAD | tr '\n' ' ')"

# A change undone since the last release isn't one.
git tag -a v0.1.10 -m v0.1.10
commit_at 5000 LICENSE
git revert --no-edit HEAD >/dev/null
check "a change and its revert" "base=v0.1.10 covered= changes=0 release=false wait=0 " "$(plan 5000)"

# A newer release is numbered from the highest version, not the latest tag, and covers what's behind it.
older=$(git rev-parse HEAD)
commit_at 6000 crates/app/src/main.rs
git tag -a v0.2.0 -m v0.2.0
check "a release tag on the commit" v0.2.0 "$($auto tag HEAD)"
check "an older commit than a release is already out" "base=v0.2.0 covered=v0.2.0 changes=1 release=false wait=0 " \
  "$(NOW=6000 $auto plan "$older" 2>/dev/null | tr '\n' ' ')"
if $auto tag "$older" >/dev/null 2>&1; then r=tagged; else r=refused; fi
check "never tag an older commit than a release" refused "$r"
if $auto tag v0.1.10 >/dev/null 2>&1; then r=tagged; else r=refused; fi
check "nor re-release one" refused "$r"
commit_at 7000 crates/app/src/main.rs
check "next after v0.2.0" v0.2.1 "$($auto tag HEAD)"

[ "$failures" = 0 ] || { echo "scripts/release/auto-test: $failures failed" >&2; exit 1; }
finished=1
