#!/bin/sh
# What auto-release.yml releases, and as which version (docs/ci.md, "Releases"): a merge to main that changes
# what the web build or the native apps are made from is released as the next patch version, once main has
# had no such merge for a while.
#
#   scripts/release/auto plan REV          whether to release REV, and in how many seconds, as key=value lines
#                                          for $GITHUB_OUTPUT: base, covered, changes, release, wait
#   scripts/release/auto tag REV           the tag to release REV as: the release tag already on it (a re-run),
#                                          or the patch after the highest; fails if a release tag is past it
#   scripts/release/auto changes BASE REV  the files that differ between BASE and REV and count for a release
#
# A release tag is vMAJOR.MINOR.PATCH. A prerelease's (v0.2.0-rc1) is neither a base nor numbered from. It
# needs the tags and their history (a clone with --filter=blob:none is enough).
set -euf
cd "$(dirname "$0")/../.."
me=scripts/release/auto

# What the releases are made from (git pathspecs): the crates the app and the asset extractor build from,
# vendor/'s math and the original's files they read (reference/), the toolchain, the license both ship with,
# and the scripts and workflow that package them (scripts/web --package, scripts/release/build). Not the
# fidelity harness, the wiki's tools, tests or Markdown, this script, nor docs/, site/ (deployed on its own)
# or wiki/.
# auto-release.yml's `paths`, which start the plan, must cover all of these.
made_from="crates vendor reference Cargo.toml Cargo.lock rust-toolchain.toml LICENSE
  scripts/cargo scripts/extract scripts/web scripts/release .github/workflows/build-native.yml
  :(exclude)crates/harness :(exclude)crates/tools/src/bin/trace-diff.rs
  :(exclude,glob)crates/tools/src/bin/wiki-* :(exclude,glob)crates/tools/src/bin/wiki-*/**
  :(exclude,glob)crates/*/tests/** :(exclude,glob)**/*.md :(exclude,glob)scripts/release/auto*"
# How long main must have had no such merge before a release starts, so merges that land together go out
# together, but never later than this long after the first of them.
quiet=600
max_wait=1800

release_tag='^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'
# The release tags passed to `git tag -l`, newest version first.
tags() { git tag -l 'v*' --sort=-v:refname "$@" | grep -E "$release_tag" || true; }
commit() {
  git rev-parse -q --verify "$1^{commit}" || { echo "$me: no commit $1" >&2; exit 2; }
}
# The lowest release tag at or after REV (whose commit has REV in its history): REV is already released.
covered() { tags --contains "$1" | tail -n 1; }
changes() {
  # shellcheck disable=SC2086 # the pathspecs, split (globbing is off: set -f)
  git diff --name-only "$1" "$2" -- $made_from
}

case ${1:-} in
  plan)
    [ $# = 2 ] || { echo "usage: $me plan REV" >&2; exit 2; }
    rev=$(commit "$2")
    base=$(tags | head -n 1)
    [ -n "$base" ] || { echo "$me: no release tag to count from" >&2; exit 1; }
    covered=$(covered "$rev")
    n=$(changes "$base" "$rev" | wc -l | tr -d ' ')
    release=false
    wait=0
    if [ -n "$covered" ]; then
      echo "$me: ${rev%"${rev#???????}"} is already released, in $covered" >&2
    elif [ "$n" = 0 ]; then
      echo "$me: nothing a release is made from changed since $base" >&2
    else
      release=true
      # The times of the commits since base that changed what a release is made from, which for pull requests
      # merged on GitHub are when they merged, newest first: other merges since don't move the release. None
      # when the changes came another way than base's history (base is off main's first parents), and then
      # REV's. $NOW is for the tests.
      now=${NOW:-$(date +%s)}
      # shellcheck disable=SC2086
      times=$(git log --format=%ct "$base..$rev" -- $made_from)
      [ -n "$times" ] || times=$(git log -1 --format=%ct "$rev")
      newest=$(echo "$times" | head -n 1)
      oldest=$(echo "$times" | tail -n 1)
      until=$((newest + quiet))
      [ $((oldest + max_wait)) -ge "$until" ] || until=$((oldest + max_wait))
      wait=$((until - now))
      [ "$wait" -gt 0 ] || wait=0
      echo "$me: changed since $base, of what a release is made from: $n files; releasing in ${wait}s" >&2
    fi
    printf 'base=%s\ncovered=%s\nchanges=%s\nrelease=%s\nwait=%s\n' "$base" "$covered" "$n" "$release" "$wait"
    ;;
  tag)
    [ $# = 2 ] || { echo "usage: $me tag REV" >&2; exit 2; }
    rev=$(commit "$2")
    on=$(tags --points-at "$rev" | head -n 1)
    # A release tag past REV: releasing REV now, or re-running its release, would offer the apps an older
    # version than one already out as an update.
    past=$(tags --contains "$rev" | grep -vxF "$on" | tail -n 1)
    [ -z "$past" ] || { echo "$me: $2 is already released, in $past" >&2; exit 1; }
    [ -z "$on" ] || { echo "$on"; exit 0; }
    base=$(tags | head -n 1)
    [ -n "$base" ] || { echo "$me: no release tag to count from" >&2; exit 1; }
    version=${base#v}
    major=${version%%.*}
    minor=${version#*.}
    patch=${minor#*.}
    minor=${minor%.*}
    echo "v$major.$minor.$((patch + 1))"
    ;;
  changes)
    [ $# = 3 ] || { echo "usage: $me changes BASE REV" >&2; exit 2; }
    base=$(commit "$2")
    rev=$(commit "$3")
    changes "$base" "$rev"
    ;;
  *)
    echo "usage: $me plan REV | tag REV | changes BASE REV" >&2
    exit 2
    ;;
esac
