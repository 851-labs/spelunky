    "lints": (1, ["*"], [], ["cargo"]),
    # Every crate's tests, and what they read (TEST_INPUTS).
    "tests": (1, ["*"], list(TEST_INPUTS), ["cargo"]),
    # The committed game code is what the transpiler (tools) makes of the reference .gmk.
    "transpile": (1, ["tools", "game", "config"], ["reference/", "scripts/transpile"], ["cargo"]),
    # The vendored math crate's own tests.
    "pxfm": (1, ["pxfm"], [], ["cargo"]),
