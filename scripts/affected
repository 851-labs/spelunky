    "angles": (1, [], ["tools/gm8-probe/", "vendor/pxfm/", "rust-toolchain.toml", "clippy.toml"], ["cargo"]),
    # Every committed replay against its fingerprint of the oracle's build (whose stamp hashes tools/oracle and
    # vendor/pxfm), on the assets scripts/extract makes from the reference.
    "fidelity": (2, ["harness"], ["fidelity/replays/", "fidelity/settings/", "fidelity/fingerprints/", "tools/oracle/",
                                  "vendor/pxfm/", "reference/", "scripts/extract"], ["cargo"]),
    # The wiki's clip specs: each still plays as its story says, and has its committed media.
    "clips": (2, ["harness"], ["wiki/clips/", "wiki/media/clips/", "fidelity/replays/", "fidelity/settings/",
                               "reference/", "scripts/extract"], ["cargo"]),
    # The site's snapshots of the wiki's data, its icons and the wiki's citations of the GML (tools' binaries).
    "wiki": (2, ["tools"], ["wiki/data/", "site/content/wiki-data/", "site/content/wiki/", "site/public/favicon.ico",
                            "site/public/icon.svg", "site/public/apple-touch-icon.png", "reference/",
                            "scripts/extract", "scripts/wiki-data", "scripts/site-icons", "scripts/wiki-cites"],
             ["cargo"]),
    # The third-party notices cover what the app links: the crates' manifests, not their code.
    "licenses": (2, [], ["Cargo.toml", "Cargo.lock", "rust-toolchain.toml", "crates/*/Cargo.toml",
                         "vendor/pxfm/Cargo.toml", "scripts/third-party-licenses", "scripts/release/licenses/",
                         "scripts/release/THIRD-PARTY-LICENSES.txt"], ["cargo"]),
    # The crates that build for wasm32, and gm's tests there, under Node.
    "wasm": (2, ["gm", "trace", "game", "app", "gmk", "assets", "audio"], ["scripts/wasm-test", "site/.node-version"],
             ["cargo", "node"]),
}
# What every half's checkout has: the scripts the job runs through (CI's own, which run every step when they change).
BASE = ["scripts/check", "scripts/affected", "scripts/check-sh"]
# And for a step that runs cargo: the whole workspace, which cargo loads to build any of it, what the crates build in
# (a change to which is a change to them, and so runs the steps that build them), and the toolchain. Being whole,
# it can't show a step's crates are too few: --test checks each step builds only its crates and what they use.
CARGO_BASE = (["crates/", "vendor/", "scripts/cargo", "scripts/seed-target", "scripts/workspace-hack"] +
              list(BUILD_INPUTS) + WORKSPACE_FILES)

