JOBS = ["run_suite", "run_mini", "run_site", "run_updater"]


def matches(path, patterns):
    for p in patterns:
        if p.endswith("/"):
            if path.startswith(p):
                return True
        elif path == p or fnmatch.fnmatchcase(path, p):
            return True
    return False


def git(*args, stdin=None):
    return subprocess.run(["git", "-c", "core.quotePath=false", *args], input=stdin, capture_output=True,
                          text=True, check=True).stdout


def kept(paths, rules):
    """The paths sparse-checkout `rules` keep: git's own matching, as the checkout does it."""
    if not paths:
        return set()
    with tempfile.NamedTemporaryFile("w", suffix=".rules", delete=False) as f:
        f.write(rules)
    try:
        out = git("sparse-checkout", "check-rules", "--no-cone", "--rules-file", f.name, stdin="\n".join(paths) + "\n")
    finally:
        os.unlink(f.name)
    return set(out.splitlines())


def packages():
    """Each crate (the workspace's members and the path crates they use): its directory and its dependents."""
    meta = json.loads(subprocess.run(["scripts/cargo", "metadata", "--no-deps", "--format-version", "1", "--offline",
                                      "--quiet"], capture_output=True, text=True, check=True).stdout)
    root = meta["workspace_root"].rstrip("/") + "/"
    dirs, users = {}, {}
    for p in meta["packages"]:
        dirs[p["name"]] = os.path.dirname(p["manifest_path"])[len(root):] + "/"
        for d in p["dependencies"]:
            if d.get("path"):
                users.setdefault(d["name"], set()).add(p["name"])
                dirs.setdefault(d["name"], d["path"][len(root):].rstrip("/") + "/")
    return dirs, users


def sh_scripts():
    """The sh scripts scripts/check-sh checks, as the index has them."""
    out = subprocess.run(["scripts/check-sh", "--tracked"], capture_output=True, text=True, check=True).stdout
    return set(out.splitlines())


def context():
    """What the decisions read besides the diff: the crates (packages()) and the sh scripts."""
    dirs, users = packages()
    return dirs, users, sh_scripts()


def dependents(crates, users):
    """`crates`, and every crate that depends on one of them, and on those."""
    crates = set(crates)
    todo = list(crates)
    while todo:
        for user in users.get(todo.pop(), ()):
            if user not in crates:
                crates.add(user)
                todo.append(user)
    return crates


def step_reads(name, sh):
    """The paths step `name` reads besides its crates (STEPS), the sh scripts' listed."""
    reads = STEPS[name][2]
    return sorted(sh) if reads is SH else reads


def was_sh(base, path):
    """Whether `path` was an sh script at `base` (scripts/check-sh's shebangs), for one a change removes."""
    got = subprocess.run(["git", "cat-file", "blob", "%s:%s" % (base, path)], capture_output=True)
    # Not there (a made-up case's file): not one, so if nothing else claims it, every step runs.
    if got.returncode != 0:
        return False
    out = got.stdout
    first = out.split(b"\n", 1)[0].rstrip(b"\r")
    return any(first == s or first.startswith(s + b" ") for s in (b"#!/bin/sh", b"#!/bin/bash", b"#!/usr/bin/env bash"))


def affected(changes, info=None, base=None):
    """`changes`: (status, path) pairs, from `base`. The areas, the crates, the suite's steps and the jobs they
    affect."""
    dirs, users, sh = info or context()
    paths = [p for _, p in changes]
    areas = {a: False for a in AREAS}
    unknown = []
    # The crates whose code changed (and below, their dependents), and those that only read a changed input.
    crates = set()
    tested = set()
    every_crate = False
    # Each file's own crates, for the suite's steps (below).
    own = {}
    for status, path in changes:
        hit = False
        for area, patterns in AREAS.items():
            if matches(path, patterns):
                areas[area] = hit = True
        for area, patterns in REMOVED.items():
            if status == "D" and matches(path, patterns):
                areas[area] = hit = True
        # The deepest crate directory the file is in (a crate inside another's directory is its own).
        owner = max((c for c, d in dirs.items() if path.startswith(d)), key=lambda c: len(dirs[c]), default=None)
        mine = {owner} if owner else set()
        for prefix, readers in BUILD_INPUTS.items():
            if matches(path, [prefix]):
                mine |= readers
        for prefix, readers in TEST_INPUTS.items():
            if matches(path, [prefix]):
                tested |= readers
        # The scripts that build or run the crates mark every crate (for the jobs) but none of the suite's steps,
        # which each name the scripts they run (STEPS): no crate's code reads them.
        whole = matches(path, WORKSPACE_FILES) or (path.startswith(("crates/", "vendor/")) and not owner)
        if whole:
            mine = set(dirs)
        if whole or matches(path, WORKSPACE_SCRIPTS):
            every_crate = True
        if not hit:
            unknown.append(path)
        crates |= mine
        own[path] = mine
    # A file no area has could be anything: every crate. CI's own files run every job (below) but change no crate.
    if every_crate or unknown:
        crates = set(dirs)
    # Each changed crate's dependents, and theirs.
    crates = dependents(crates, users)
    if crates & MEDIA_CRATES:
        areas["media"] = True
    code = set(crates)
    crates |= tested
    if "update" in crates:
        areas["release"] = True
    docs_only = bool(paths) and all(matches(p, AREAS["docs"]) for p in paths) and not (
        areas["site"] or areas["rust"])
    everything = bool(unknown) or areas["ci"]
    # The suite's steps: each file the suite reads runs the steps that read it, or every step if none does (when
    # unsure, run it). A file the suite's checkout hasn't (SUITE_RULES) can't change what a step does.
    read = kept(paths, SUITE_RULES)
    steps, unclaimed = set(), []
    for status, path in changes:
        if path not in read:
            continue
        mine = dependents(own[path], users)
        hits = {name for name, (_, step_crates, _, _) in STEPS.items()
                if (mine and (step_crates == ["*"] or mine & set(step_crates))) or matches(path, step_reads(name, sh))}
        # A removed sh script is gone from check-sh's list (the index's), so it's the base's that says it was one.
        if status == "D" and base and was_sh(base, path):
            hits.add("sh")
        if not hits:
            unclaimed.append(path)
        steps |= hits
    if everything or unclaimed:
        steps = set(STEPS)
    jobs = {
        "run_suite": bool(steps),
        "run_mini": everything or bool(kept(paths, MINI_RULES)),
        "run_site": everything or areas["site"],
        # `cargo test -p update`: the updater crate or one it depends on (cargo metadata), or its workflow (ci).
        "run_updater": everything or "update" in crates,
    }
    return dict(areas=areas, crates=crates, code=code, unknown=unknown, unclaimed=unclaimed, docs_only=docs_only,
                steps=steps, jobs=jobs)


def suite_steps(steps):
    """The suite's steps as pr.yml passes them on: `all`, or their names."""
    return "all" if steps == set(STEPS) else " ".join(sorted(steps))


def suite_parts(steps):
    """The halves of the suite that have a step to run, as a JSON list (suite.yml's matrix)."""
    return json.dumps(sorted({STEPS[s][0] for s in steps}))


def diff(base, head):
    out = git("diff", "--name-status", "--no-renames", base, head)
    return [(line.split("\t", 1)[0][0], line.split("\t", 1)[1]) for line in out.splitlines() if line]


def outputs(result):
    lines = ["%s=%s" % (a, str(v).lower()) for a, v in result["areas"].items()]
    lines.append("docs_only=%s" % str(result["docs_only"]).lower())
    lines.append("crates=%s" % " ".join(sorted(result["crates"])))
    lines += ["%s=%s" % (j, str(result["jobs"][j]).lower()) for j in JOBS]
    lines.append("suite_steps=%s" % suite_steps(result["steps"]))
    lines.append("suite_parts=%s" % suite_parts(result["steps"]))
    return lines


def literal(path):
    """A file's path as a sparse-checkout rule (gitignore's) that matches it alone."""
    return re.sub(r"([*?\[\\])", r"\\\1", path)


def suite_rules(steps, sh):
    """The sparse-checkout rules of what the suite's `steps` read (STEPS): SUITE_RULES for all of them."""
    if not steps or set(steps) == set(STEPS):
        return SUITE_RULES
    paths = list(BASE)
    if any("cargo" in STEPS[s][3] for s in steps):
        paths += CARGO_BASE
    for s in sorted(steps):
        paths += [literal(p) for p in sorted(sh)] if STEPS[s][2] is SH else STEPS[s][2]
    return "".join("/%s\n" % p for p in dict.fromkeys(paths))


def plan(part, names):
    """What half `part` of the suite runs of `names` (`all`, or the steps pr.yml passes on), as name=value lines:
    `only` (its steps, for scripts/check --only, or `all`), and whether it needs `cargo`, `node`, and the `sh`
    scripts' guard (suite.yml)."""
    every = names == ["all"]
    bad = [n for n in names if n not in STEPS] if not every else []
    if bad:
        raise ValueError("no step %s" % ", ".join(bad))
    mine = sorted(s for s in STEPS if STEPS[s][0] == part and (every or s in names))
    if not mine:
        raise ValueError("no step of part %d in %s" % (part, " ".join(names)))
    needs = {n for s in mine for n in STEPS[s][3]}
    return ["only=%s" % ("all" if every else " ".join(mine)), "cargo=%s" % str("cargo" in needs).lower(),
            "node=%s" % str("node" in needs).lower(), "sh=%s" % str("sh" in mine).lower()]


def self_test():
    info = context()
    failed = 0

    def fail(message):
        nonlocal failed
        print("scripts/affected --test: %s" % message, file=sys.stderr)
        failed = 1

    for name, files, want in CASES:
        changes = [(f[0], f[2:]) if f.startswith("D ") else ("M", f) for f in files]
        r = affected(changes, info, base="HEAD")
        got = dict(r["jobs"], docs_only=r["docs_only"], unknown=bool(r["unknown"]), crates=r["crates"],
                   steps=suite_steps(r["steps"]), **r["areas"])
        for key, value in want.items():
            if got[key] != value:
                fail("%s: %s is %s, not %s" % (name, key, got[key] or "nothing", value or "nothing"))
    dirs, users, sh = info
    tracked = set(git("ls-files").splitlines())
    tracked_dirs = {t.rsplit("/", i)[0] + "/" for t in tracked for i in range(1, t.count("/") + 1)}
    in_suite = kept(sorted(tracked), SUITE_RULES)
    # Every repository path a crate's sources name (a string starting with a top-level directory, or "../" up to
    # one), but its own and other crates', is an input for that crate in BUILD_INPUTS or TEST_INPUTS, or read by a
    # suite step that runs the crate's binaries (STEPS), or outside what the suite reads (the mini's: SUITE_RULES).
    tops = sorted({t.split("/", 1)[0] for t in tracked if "/" in t} - {"crates", ".github"})
    top_files = sorted(t for t in tracked if "/" not in t)
    pattern = r'"(\.\./)*((%s)/[A-Za-z0-9_.-]+|(%s)")' % ("|".join(map(re.escape, tops)),
                                                         "|".join(map(re.escape, top_files)))
    inputs = list(BUILD_INPUTS.items()) + list(TEST_INPUTS.items()) + [
        (p, set(c)) for _, c, reads, _ in STEPS.values() if reads is not SH and c != ["*"] for p in reads]
    for crate, d in sorted(dirs.items()):
        if not d.startswith("crates/"):
            continue
        grep = subprocess.run(["git", "grep", "-hoE", pattern, "--", d], capture_output=True, text=True)
        # 1 is no match; anything else, a failure, which mustn't pass for a clean scan.
        if grep.returncode > 1:
            raise RuntimeError("git grep failed: %s" % grep.stderr.strip())
        for found in sorted(set(grep.stdout.splitlines())):
            path = found.strip('"')
            while path.startswith("../"):
                path = path[3:]
            # Only a path that's there: GML's script names (`scripts/scrInit`) look like one.
            if path not in tracked:
                if path.rstrip("/") + "/" not in tracked_dirs:
                    continue
                path = path.rstrip("/") + "/"
            # A directory is covered by an entry for it, one around it, or one in it (the scan sees a path's first two
            # names: "wiki/media/clips" is wiki/media/).
            if not any((matches(path, [prefix]) or path == prefix or (path.endswith("/") and prefix.startswith(path)))
                       and crate in readers
                       for prefix, readers in inputs) and \
                    not matches(path, AREAS["ci"] + WORKSPACE_FILES + WORKSPACE_SCRIPTS + ["vendor/"]) and \
                    not (path in tracked and path not in in_suite) and \
                    not (path.endswith("/") and not any(t.startswith(path) for t in in_suite)):
                fail("%s reads %s, which BUILD_INPUTS, TEST_INPUTS and STEPS don't give it" % (crate, path))
    # Every pattern names something that exists, so a move or a rename doesn't leave one matching nothing.
    for area, patterns in list(AREAS.items()) + list(REMOVED.items()):
        for p in patterns:
            if not (p in tracked or p in tracked_dirs or any(fnmatch.fnmatchcase(t, p) for t in tracked)):
                fail("%s's %s matches no tracked file" % (area, p))
    # The steps' paths: each matches something, and only what the suite's checkout has (SUITE_RULES), which a run
    # of every step has (so a path a step reads that SUITE_RULES drop would fail only there).
    def in_checkout(owner, patterns):
        for p in patterns:
            files = {t for t in tracked if matches(t, [p])}
            if not files:
                fail("%s's %s matches no tracked file" % (owner, p))
            elif files - in_suite:
                fail("%s's %s takes %s, which SUITE_RULES leave out" % (owner, p, sorted(files - in_suite)[0]))

    in_checkout("BASE", BASE)
    in_checkout("CARGO_BASE", CARGO_BASE)
    check = open("scripts/check").read()
    for name, (_, step_crates, reads, _) in sorted(STEPS.items()):
        for c in step_crates:
            if c != "*" and c not in dirs:
                fail("%s's crate %s isn't one" % (name, c))
        if reads is not SH:
            in_checkout(name, reads)
        # Each package the step builds by name (`-p NAME`, in its block of scripts/check and the scripts it runs
        # there: not `cargo tree`'s, which reads the manifests) is one of its crates or one they use, so a change to
        # it runs the step: the checkout, which has the whole workspace, can't show it.
        block = "\n".join(re.findall(r"^if step [12] %s; then\n(.*?)^fi$" % re.escape(name), check, re.M | re.S))
        texts = [block] + [open(p).read() for p in (reads if reads is not SH else []) if p.startswith("scripts/")
                           and p in tracked and re.search(r"\b%s\b" % re.escape(p), block)]
        for text in texts:
            for line in text.splitlines():
                if "cargo tree" in line or line.lstrip().startswith("#"):
                    continue
                for built in re.findall(r"(?:^|\s)-p ([A-Za-z0-9_-]+)", line):
                    if built in dirs and step_crates != ["*"] and not dependents({built}, users) & set(step_crates):
                        fail("step %s builds %s, which isn't one of its crates nor one they use" % (name, built))
    # The angle probes' tool is a workspace of its own, which cargo metadata doesn't see: its path dependencies
    # are in its row.
    for dep in re.findall(r'path = "([^"]+)"', open("tools/gm8-probe/angles/Cargo.toml").read()):
        target = os.path.normpath(os.path.join("tools/gm8-probe/angles", dep)) + "/"
        if not matches(target, STEPS["angles"][2]):
            fail("the angle probes' tool uses %s, which its row hasn't" % target)
    if not sh or sh - in_suite:
        fail("the sh scripts aren't all in SUITE_RULES: %s" % sorted(sh - in_suite)[:3])
    # Every file the suite reads is some step's, so a change to it runs that step rather than all of them (which
    # it would: affected's `unclaimed`).
    # (Not CI's own files, nor one no area has, which run every step anyway.)
    r = affected([("M", t) for t in sorted(in_suite) if not matches(t, AREAS["ci"]) and
                  any(matches(t, patterns) for patterns in AREAS.values())], info)
    for path in r["unclaimed"]:
        fail("no step reads %s, which the suite's checkout has (SUITE_RULES): give it a step's row, or leave it "
             "out of SUITE_RULES" % path)
    # scripts/check's steps are these: its lists of each half's (steps1, steps2), and its `step PART NAME`s.
    for part in (1, 2):
        listed = re.search(r'^steps%d="([^"]*)"$' % part, check, re.M)
        want = sorted(s for s in STEPS if STEPS[s][0] == part)
        if not listed or sorted(listed.group(1).split()) != want:
            fail("scripts/check's steps%d isn't %s" % (part, " ".join(want)))
    used = set(re.findall(r"\bstep ([12]) ([a-z0-9-]+)\b", check))
    for part, name in sorted(used):
        if STEPS.get(name, (None,))[0] != int(part):
            fail("scripts/check runs step %s %s, which STEPS hasn't in part %s" % (part, name, part))
    for name in sorted(set(STEPS) - {n for _, n in used}):
        fail("scripts/check never runs step %s" % name)
    return failed


def main(argv):
    os.chdir(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
    usage = ("usage: scripts/affected BASE HEAD | --is AREA BASE HEAD | --rules suite [STEP...|all] | --rules mini |"
             " --plan 1|2 STEP...|all | --paths AREA | --test")
    if argv == ["--test"]:
        return self_test()
    if argv == ["--rules", "mini"]:
        sys.stdout.write(MINI_RULES)
        return 0
    # The steps as one argument or several ("$ONLY" or $ONLY).
    names = " ".join(argv[2:]).split()
    if argv[:2] == ["--rules", "suite"]:
        if names == ["all"]:
            names = []
        if any(n not in STEPS for n in names):
            print(usage, file=sys.stderr)
            return 2
        sys.stdout.write(suite_rules(names, sh_scripts() if "sh" in names else set()))
        return 0
    if len(argv) >= 3 and argv[0] == "--plan" and argv[1] in ("1", "2"):
        print("\n".join(plan(int(argv[1]), names)))
        return 0
    if len(argv) == 2 and argv[0] == "--paths" and argv[1] in AREAS:
        print("\n".join(AREAS[argv[1]]))
        return 0
    if len(argv) == 4 and argv[0] == "--is" and argv[1] in AREAS:
        return 0 if affected(diff(argv[2], argv[3]), base=argv[2])["areas"][argv[1]] else 1
    if len(argv) != 2 or argv[0].startswith("-"):
        print(usage, file=sys.stderr)
        return 2
    result = affected(diff(argv[0], argv[1]), base=argv[0])
    lines = outputs(result)
    print("\n".join(lines))
    if result["unknown"]:
        print("no area has %s: running every job" % ", ".join(result["unknown"]), file=sys.stderr)
    if os.environ.get("GITHUB_OUTPUT"):
        with open(os.environ["GITHUB_OUTPUT"], "a") as f:
            f.write("\n".join(lines) + "\n")
    return 0


if __name__ == "__main__":
    # Any error is 2, never 1, which --is means "not affected": a failure mustn't pass for a skip.
    try:
        sys.exit(main(sys.argv[1:]))
    except Exception as e:  # noqa: BLE001 (every error: see above)
        detail = getattr(e, "stderr", None) or ""
        if isinstance(detail, bytes):
            detail = detail.decode("utf-8", "replace")
        print("scripts/affected: %s%s" % (e, ("\n" + detail.strip()) if detail else ""), file=sys.stderr)
        sys.exit(2)
