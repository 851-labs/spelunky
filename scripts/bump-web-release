#!/bin/sh
# Points the site at a release's web build: scripts/bump-web-release TAG writes TAG and the SHA-256 of
# its spelunky-web-TAG.tar.gz (downloaded from the public GitHub Release) into site/web-release.txt.
# Merging that change is the deploy (docs/web-deploy.md).
set -eu
[ $# = 1 ] || { echo "usage: scripts/bump-web-release TAG" >&2; exit 2; }
tag=$1
cd "$(dirname "$0")/.."
url=https://github.com/851-labs/spelunky/releases/download/$tag/spelunky-web-$tag.tar.gz
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
curl -fsSL --retry 3 -o "$tmp/web.tar.gz" "$url" || { echo "scripts/bump-web-release: couldn't download $url" >&2; exit 1; }
tar -tzf "$tmp/web.tar.gz" index.html >/dev/null 2>&1 ||
  { echo "scripts/bump-web-release: $url isn't a scripts/web --package build" >&2; exit 1; }
if command -v sha256sum >/dev/null; then sha=$(sha256sum "$tmp/web.tar.gz"); else sha=$(shasum -a 256 "$tmp/web.tar.gz"); fi
sha=${sha%% *}
# Keeps the comment at the top; replaces the tag and sha256 lines.
awk -v tag="$tag" -v sha="$sha" '
  $1 == "tag" { print "tag " tag; next }
  $1 == "sha256" { print "sha256 " sha; next }
  { print }
' site/web-release.txt >"$tmp/web-release.txt"
mv "$tmp/web-release.txt" site/web-release.txt
echo "site/web-release.txt: $tag ($sha)"
