#!/bin/sh
# The full check suite: what CI's `pr-ok` runs on every pull request (docs/ci.md), on GitHub's Linux machines
# (.github/workflows/suite.yml). Pass --fast for the pre-commit subset, which is only what's instant: formatting,
# the oracle's arithmetic copy, the sh scripts' syntax and the workflows' actions pinned to commit SHAs. Pass --apple for what CI checks on a Mac mini beside
# the Linux run: the sh scripts' syntax under macOS's sh (bash 3.2, where Linux's is dash), the macOS-only code's
# lints and tests, which Linux doesn't compile, crates/workspace-hack's checks, which are Apple silicon Macs', and
# the committed replays on the Mac app's own architecture (fidelity-check: the port must be the same on both), and
# the renderer's pictures against the oracle's (fidelity-shots, which needs a GPU). On
# such a Mac, the full suite runs all of it.
#
# Pass --part 1 or --part 2 for one half of the full suite, which CI's Linux suite runs on two machines side by side
# (851-3998). Together they're all of it, each step in one of them. The halves are split by what they build, so
# neither builds what the other does: 1 is the instant checks and the dev and test builds (the transpiler and every
# test); 2 is the release builds (the assets, the replays, the wiki's and site's checks), clippy, which builds
# nothing the tests reuse, and wasm32.
set -eu
cd "$(dirname "$0")/.."
cargo=scripts/cargo
# Optional features that are off by default but must keep building: audio's device backend.
features="--features audio/backend"
one=1
two=1
if [ "${1:-}" = "--part" ]; then
  case ${2:-} in
    1) two= ;;
    2) one= ;;
    *) echo "usage: scripts/check [--fast | --apple | --part 1|2]" >&2; exit 2 ;;
  esac
fi
if [ "${1:-}" = "--apple" ]; then
  [ "$(uname -s) $(uname -m)" = "Darwin arm64" ] || { echo "scripts/check --apple: for Apple silicon Macs" >&2; exit 1; }
  scripts/check-sh
  # The minis' job-started hook, which keeps forks' pull requests off them (docs/ci.md), on made-up events.
  .github/runner-hooks/test.sh >/dev/null
  scripts/workspace-hack --check
  # The workspace as macOS compiles it: the app's menus, alerts and power assertions, the updater's installer.
  $cargo clippy --workspace --all-targets $features --quiet -- -D warnings
  $cargo clippy -p app --no-default-features --all-targets --quiet -- -D warnings
  # The app's own tests on macOS (the updater's run on GitHub's macOS machines: updater.yml), and every member's
  # test build, which --reused compares a member's own with.
  $cargo test --workspace $features --quiet --no-run
  $cargo test -p app $features --quiet
  scripts/workspace-hack --reused
  scripts/extract >/dev/null
  $cargo run --quiet --release -p harness --bin fidelity-check
  # The renderer against the oracle's pictures of chosen frames (fidelity/screenshots/): it needs the GPU.
  scripts/fidelity-shots
  exit 0
fi
if [ -n "$one" ]; then
  $cargo fmt --all --check
  $cargo fmt --manifest-path tools/gm8-probe/angles/Cargo.toml --check
  # The oracle's patch 0014 carries a copy of crates/gm/src/gm8.rs, which must be current.
  python3 -I tools/oracle/sync-gm8-arith --check
  # Every sh script parses: macOS's sh passes one that stops at a syntax error after an EXIT trap (851-3741).
  scripts/check-sh
  # Every action the workflows use is pinned to a full commit SHA, its version in a comment, as a tag can be moved to
  # other code (851-3902; .github/dependabot.yml moves the pins).
  unpinned=$(grep -rnE 'uses: [^.][^@ ]*@' .github | grep -vE 'uses: [^@ ]+@[0-9a-f]{40} # v[0-9]' || true)
  [ -z "$unpinned" ] || { printf 'scripts/check: actions not pinned to a commit SHA with its version:\n%s\n' "$unpinned" >&2; exit 1; }
  [ "${1:-}" = "--fast" ] && exit 0
  # A build of one package must resolve the workspace's features, so a worktree reuses the main checkout's
  # builds (crates/workspace-hack, 851-3738).
  scripts/workspace-hack --check
  # The committed game code must be what the transpiler generates from the reference .gmk.
  scripts/transpile --check
  $cargo test --workspace $features --quiet
  # Which a member's own test build reuses whole (crates/workspace-hack): as a worktree's would, off the main checkout's.
  scripts/workspace-hack --reused
  # The vendored math crate is its own workspace; its tests include our hypot's (851-3174).
  $cargo test --manifest-path vendor/pxfm/Cargo.toml --quiet
  # So is the angle probes' tool: its bounding-box model must still match the results measured on GM8 (851-3287).
  angles="--manifest-path tools/gm8-probe/angles/Cargo.toml --target-dir target/gm8-angle-probes"
  $cargo clippy $angles --all-targets --quiet -- -D warnings
  $cargo test $angles --quiet
fi
if [ -n "$two" ]; then
  $cargo clippy --workspace --all-targets $features --quiet -- -D warnings
  # Default features that may be turned off must keep building without them: the app's gamepad support.
  $cargo clippy -p app --no-default-features --all-targets --quiet -- -D warnings
  # Every committed replay, on the port, against its fingerprint of the oracle's run (no Docker needed).
  # The assets are rebuilt first (it's quick when they're current), so the check never runs on stale ones.
  scripts/extract >/dev/null
  $cargo run --quiet --release -p harness --bin fidelity-check
  # The renderer against the oracle's pictures (fidelity/screenshots/), where the Mac's GPU renders it, as --apple does.
  if [ "$(uname -s) $(uname -m)" = "Darwin arm64" ]; then
    scripts/fidelity-shots
  fi
  # The wiki's clip specs (wiki/clips/): each still plays and shows what its story facts say, and has its
  # committed media (wiki/media/clips), with what the spec says, and no clip there is without one. It renders
  # nothing, so it needs neither a GPU nor ffmpeg; the web job checks the renders (docs/wiki-media.md).
  $cargo run --quiet --release -p harness --bin wiki-clips -- --check --media wiki/media/clips
  # The site's committed snapshots of the wiki's stats and relations (site/content/wiki-data/) must be what the
  # GML and the specs give, since the site's build can't run wiki-data itself (docs/wiki-data.md).
  scripts/wiki-data --check >/dev/null
  # So must the site's icons (site/public/favicon.ico and the rest), made from the game's sprite.
  scripts/site-icons --check
  # The third-party notices every release and the web build ship must cover every crate the app links, on every
  # platform (docs/releasing.md, "Third-party licenses").
  scripts/third-party-licenses --check >/dev/null
  # The wiki's pages against the GML they cite: each path and line range exists and each ```gml excerpt is
  # its lines, which the site's build can't check without the GML (docs/wiki-style.md, "Citing the code").
  scripts/wiki-cites >/dev/null
  $cargo check --quiet --target wasm32-unknown-unknown -p gm -p trace -p game -p app -p gmk -p assets -p audio
  $cargo check --quiet --target wasm32-unknown-unknown -p audio $features
  scripts/wasm-test
fi
