#!/bin/sh
# Builds the browser version into target/web and serves it at http://localhost:8000 (PORT=N for another).
#
#   scripts/web            build (release) and serve
#   scripts/web --dev      the debug profile: builds faster, runs slower
#   scripts/web --check    build only, without the assets, as a check
#   scripts/web --package OUT.tar.gz
#                          a release build packaged for the site (site/build.sh unpacks it at /play/),
#                          plus OUT.tar.gz.sha256
#
# The page takes the native app's options as a query: ?replay=URL&mute&no-gamepad&physical-keys, or
# ?preview&room=rTutorial&view=0,64&scale=3, or ?replay=URL&embed&from=F for a replay a page drives (the
# wiki's live clips). A replay URL is relative to the page, so put the file in target/web.
#
# Just wasm-bindgen and a static server, not trunk: that's all the build needs. The CLI must be the exact
# version of the wasm-bindgen crate in Cargo.lock, so it's installed from that into target/tools on first
# use (a minute or two), and nothing global. The server is Node's, which scripts/check already needs.
set -eu
# A syntax error anywhere fails it here, before the EXIT trap below can pass it: macOS's sh, bash 3.2, exits from
# one with the trap's status, 0 (851-3743, as site/test.sh does; scripts/check-sh).
sh -n "$0" || exit 2
usage() { echo "usage: scripts/web [--dev] [--check | --package OUT.tar.gz]" >&2; exit 2; }
profile=release
serve=1
package=
while [ $# -gt 0 ]; do
  case $1 in
    --dev) profile=debug ;;
    --check) serve= ;;
    --package) case ${2-} in ""|-*) usage ;; esac
      # Relative to where it was run: the script cds to the repo next.
      case $2 in /*) package=$2 ;; *) package=$PWD/$2 ;; esac
      serve=; shift ;;
    *) usage ;;
  esac
  shift
done
if [ -n "$package" ] && [ "$profile" != release ]; then
  echo "scripts/web: --package is a release build; drop --dev" >&2
  exit 2
fi
cd "$(dirname "$0")/.."

version=$(awk '/^name = "wasm-bindgen"$/ { getline; gsub(/version = |"/, ""); print }' Cargo.lock)
tools=target/tools/wasm-bindgen-$version
if [ ! -x "$tools/bin/wasm-bindgen" ]; then
  echo "scripts/web: installing wasm-bindgen-cli $version into $tools" >&2
  scripts/cargo install --quiet --locked --root "$tools" wasm-bindgen-cli --version "$version"
fi

release=
[ "$profile" = release ] && release=--release
scripts/cargo build --quiet -p app --target wasm32-unknown-unknown $release
# Overwritten in place, not cleared: replays put there for ?replay= survive a rebuild.
out=target/web
mkdir -p "$out"
"$tools/bin/wasm-bindgen" --target web --no-typescript --out-dir "$out" \
  "target/wasm32-unknown-unknown/$profile/app.wasm"
cp crates/app/web/index.html "$out/"
[ -n "$serve$package" ] || exit 0

if [ ! -f assets/bundle.bin ]; then
  echo "scripts/web: no assets/bundle.bin; run scripts/extract first" >&2
  exit 1
fi
# The bundle's files only: assets/gml is the extracted source, not game data.
rm -rf "$out/assets"
mkdir "$out/assets"
cp -R assets/bundle.bin assets/atlas assets/backgrounds assets/sounds "$out/assets/"
# The settings program's (?settings), if extracted.
if [ -f assets/config/bundle.bin ]; then
  mkdir "$out/assets/config"
  cp -R assets/config/bundle.bin assets/config/atlas assets/config/backgrounds "$out/assets/config/"
fi

if [ -n "$package" ]; then
  [ -f assets/config/bundle.bin ] || { echo "scripts/web: --package needs assets/config; run scripts/extract" >&2; exit 1; }
  # Everything but the page goes in v/HASH/, HASH being of every file's contents, so the site can cache
  # it forever (immutable) and a new release is a new directory. The page names it with <base>, which
  # app.js's import and the app's fetches (assets/, and a ?replay= URL) resolve against; only it
  # (no-cache) changes.
  stage=$(mktemp -d)
  # Set where it ends, so a run that stops anywhere before fails, whatever the shell's status says: bash 3.2 exits
  # from an error (an unset variable under set -u) with this trap's status, 0 for a cleanup (851-3743).
  finished=
  cleanup() {
    status=$?
    rm -rf "$stage"
    if [ "$status" -eq 0 ] && [ -z "$finished" ]; then
      echo "scripts/web: stopped before its end, so it fails" >&2
      status=1
    fi
    exit "$status"
  }
  trap cleanup EXIT
  build=$stage/build
  mkdir "$build"
  # With the license, which a Covered Work has to come with.
  cp -R "$out/app.js" "$out/app_bg.wasm" "$out/assets" LICENSE "$build/"
  hash=$(cd "$build" && find . -type f | LC_ALL=C sort | xargs shasum -a 256 | shasum -a 256 | cut -c1-16)
  mkdir -p "$stage/play/v"
  mv "$build" "$stage/play/v/$hash"
  awk -v base="<base href=\"v/$hash/\">" '{ print } /<meta charset=/ { print base; n++ } END { exit n != 1 }' \
    crates/app/web/index.html >"$stage/play/index.html" ||
    { echo "scripts/web: couldn't add <base> to index.html" >&2; exit 1; }
  # What's in it, for checking a deployed site against a release: /play/manifest.txt.
  (cd "$stage/play" && find . -type f ! -name manifest.txt | LC_ALL=C sort | sed 's|^\./||' |
    xargs shasum -a 256 >manifest.txt)
  # No macOS ._ files (COPYFILE_DISABLE) or extended attributes in it.
  (cd "$stage/play" && COPYFILE_DISABLE=1 LC_ALL=C tar --no-xattrs -czf "$package" index.html manifest.txt v)
  (cd "$(dirname "$package")" && shasum -a 256 "$(basename "$package")" >"$package.sha256")
  echo "$package ($hash)"
  cat "$package.sha256"
  finished=1
  exit 0
fi

port=${PORT:-8000}
echo "serving $out at http://localhost:$port/"
# WebGPU needs a secure context, which localhost is. Loopback only: this is a dev server.
exec node - "$out" "$port" <<'EOF'
const http = require("node:http");
const fs = require("node:fs");
const path = require("node:path");
const [root, port] = process.argv.slice(2).map((a, i) => (i ? Number(a) : path.resolve(a)));
const types = {
  ".html": "text/html", ".js": "text/javascript", ".wasm": "application/wasm", ".png": "image/png",
  ".txt": "text/plain", ".ogg": "audio/ogg", ".wav": "audio/wav",
};
http.createServer((req, res) => {
  let file;
  try {
    const url = decodeURIComponent(new URL(req.url, "http://localhost").pathname);
    file = path.join(root, url.endsWith("/") ? url + "index.html" : url);
    if (!file.startsWith(root + path.sep) || file.includes("\0")) throw new Error();
  } catch {
    return res.writeHead(400).end();
  }
  fs.readFile(file, (err, data) => {
    if (err) return res.writeHead(404).end();
    res.writeHead(200, {
      "content-type": types[path.extname(file)] ?? "application/octet-stream",
      "cache-control": "no-store",
    });
    res.end(data);
  });
}).listen(port, "127.0.0.1");
EOF
