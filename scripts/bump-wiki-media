#!/bin/sh
# Points the site's wiki at a release's media (docs/wiki-media.md, "Publishing"): scripts/bump-wiki-media TAG
# downloads the release's package from the public GitHub Release (a wiki-media-* release's TAG.tar.gz, a game
# release's wiki-media-TAG.tar.gz, as site/wiki-media.sh names them), checks it as site/wiki-media.sh unpacks
# it, and writes TAG, its SHA-256 and the date the release was published into site/wiki-media.txt. Merging
# that change is the deploy (docs/web-deploy.md).
#   scripts/bump-wiki-media TAG          wiki-media.yml's bump branch, or by hand
#   scripts/bump-wiki-media --game TAG   as scripts/bump-web-release runs it: a game release without media
#                                        (made before the release workflow rendered them) leaves the pin
#                                        alone, and so does a wiki-media-* pin of a commit the game's tag
#                                        doesn't contain: the newest commit's media win
# GH_TOKEN, if set, authenticates the API requests, which CI's shared address would otherwise make against a
# small unauthenticated quota.
set -eu
usage() { echo "usage: scripts/bump-wiki-media [--game] TAG" >&2; exit 2; }
game=
case $#:${1-} in
  1:-*) usage ;;
  1:*) tag=$1 ;;
  2:--game) game=1 tag=$2 ;;
  *) usage ;;
esac
cd "$(dirname "$0")/.."
case $tag in
  wiki-media-*) file=$tag.tar.gz ;;
  *) file=wiki-media-$tag.tar.gz ;;
esac
url=https://github.com/851-labs/spelunky/releases/download/$tag/$file
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
sha256() {
  if command -v sha256sum >/dev/null; then sum=$(sha256sum "$1"); else sum=$(shasum -a 256 "$1"); fi
  echo "${sum%% *}"
}

repo=https://api.github.com/repos/851-labs/spelunky
auth=
[ -z "${GH_TOKEN-}" ] || auth="Authorization: Bearer $GH_TOKEN"
# Into a variable (`x=$(api ...)`), so a failure stops the script, as it wouldn't in a pipeline.
api() {
  curl -fsSL --retry 3 ${auth:+-H "$auth"} "$repo/$1" ||
    { echo "scripts/bump-wiki-media: couldn't fetch $repo/$1" >&2; exit 1; }
}
if [ -n "$game" ]; then
  # wiki-media.yml's media of a commit after the game's tag show more than the game's: keep them, and main's
  # media over a release tagged off main (a hotfix: "diverged"), as wiki/clips/ lives on main. Not by when
  # each was published: a game release takes over an hour, so media of a later commit can come out first.
  # (A game release's pin is replaced either way: going back to an older release is a rollback.)
  pinned=$(awk '$1 == "tag" { print $2 }' site/wiki-media.txt)
  case $pinned in
    wiki-media-*)
      compare=$(api "compare/$tag...$pinned?per_page=1")
      # The comparison's own status comes before its files'.
      order=$(printf '%s\n' "$compare" | grep -Eo '"status": *"(ahead|behind|identical|diverged)"' |
        head -1 | cut -d'"' -f4)
      [ -n "$order" ] || { echo "scripts/bump-wiki-media: no status comparing $tag with $pinned" >&2; exit 1; }
      if [ "$order" = ahead ] || [ "$order" = diverged ]; then
        echo "scripts/bump-wiki-media: site/wiki-media.txt keeps $pinned, of a commit $tag doesn't contain" >&2
        exit 0
      fi
      ;;
  esac
fi
# When the release was published: the clips' uploadDate (site/src/seo/media.ts).
release=$(api "releases/tags/$tag")
date=$(printf '%s\n' "$release" | grep -o '"published_at": *"[^"]*"' | head -1 | cut -d'"' -f4)
[ -n "$date" ] || { echo "scripts/bump-wiki-media: no published_at for $tag" >&2; exit 1; }

# Any failure but a game release's missing media stops here, or the site would go live without them.
status=$(curl -sSL --retry 3 -o "$tmp/wiki-media.tar.gz" -w '%{http_code}' "$url") || status=failed
case $status:$game in
  200:*) ;;
  404:1)
    echo "scripts/bump-wiki-media: $tag has no $file, so site/wiki-media.txt keeps its pin" >&2
    exit 0
    ;;
  *) echo "scripts/bump-wiki-media: couldn't download $url ($status)" >&2; exit 1 ;;
esac
mkdir "$tmp/wiki"
site/wiki-media.sh "$tmp/wiki" --local "$tmp/wiki-media.tar.gz" >/dev/null ||
  { echo "scripts/bump-wiki-media: $url isn't a scripts/wiki-media-package build" >&2; exit 1; }
sha=$(sha256 "$tmp/wiki-media.tar.gz")
# Keeps the comment at the top; replaces the other lines.
awk -v tag="$tag" -v sha="$sha" -v date="$date" '
  $1 == "tag" || $1 == "sha256" || $1 == "date" { next }
  { print }
  END { print "tag " tag; print "sha256 " sha; print "date " date }
' site/wiki-media.txt >"$tmp/wiki-media.txt"
mv "$tmp/wiki-media.txt" site/wiki-media.txt
echo "site/wiki-media.txt: $tag ($sha, published $date)"
